{
  "name": "mokletcare",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node app.js",
    "dev": "concurrently \"npm run build:css -- --watch\" \"nodemon -e js,ejs app.js\"",
    "build:css": "npx @tailwindcss/cli -i ./public/stylesheets/input.css -o ./public/stylesheets/style.css",
    "migrate": "node ./scripts/migrate.js",
    "lint": "eslint .",
    "lint:ejs": "node -e 'const fs=require(\"fs\"),path=require(\"path\"),ejs=require(\"ejs\");fs.readdirSync(\"views\").filter(f=>f.endsWith(\".ejs\")).forEach(f=>ejs.compile(fs.readFileSync(path.join(\"views\",f),\"utf8\"),{filename:path.join(\"views\",f)}));console.log(\"All EJS templates valid!\");'"
  },
  "dependencies": {
    "@clerk/express": "^2.1.54",
    "cloudinary": "^1.41.3",
    "compression": "^1.8.1",
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.0",
    "http-errors": "~1.6.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "~1.9.1",
    "multer": "^2.2.0",
    "multer-storage-cloudinary": "^4.0.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "concurrently": "^10.0.4",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4.3.3"
  }
}
