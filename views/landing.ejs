<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <!-- Google Analytics: Enabled in Production, zero-latency stub in Development -->
  <% const gaId = locals.gaMeasurementId || 'G-6M87BW75P1'; %>
  <% if (process.env.NODE_ENV === 'production' && gaId) { %>
    <script async src="https://www.googletagmanager.com/gtag/js?id=<%= gaId %>"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', '<%= gaId %>', {
        page_title: '<%= title %>',
        page_path: window.location.pathname
      });
    </script>
  <% } else { %>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){/* Dev environment: local telemetry stub */}
    </script>
  <% } %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="MokletCare — Inovasi Digital Manajemen dan Pelaporan Fasilitas Sekolah SMK Telkom Malang.">
  <title><%= title %></title>
  <link rel="stylesheet" href="/stylesheets/style.css?v=<%= locals.assetVersion || '2.0.4' %>">
  
  <!-- Typography: Plus Jakarta Sans & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after {
      box-shadow: none !important;
      text-shadow: none !important;
      -webkit-box-shadow: none !important;
    }
    body {
      font-family: "Plus Jakarta Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    .font-mono-code {
      font-family: "JetBrains Mono", monospace;
    }
    .bg-grid-subtle {
      background-size: 32px 32px;
      background-image: 
        linear-gradient(to right, rgba(15, 23, 42, 0.04) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(15, 23, 42, 0.04) 1px, transparent 1px);
    }
    ::-webkit-scrollbar {
      width: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #f8fafc;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
    @keyframes gandr-ltr {
      0% {
        transform: translate3d(-50%, 0, 0);
      }
      100% {
        transform: translate3d(0, 0, 0);
      }
    }
    .gandr-track-1 {
      display: flex;
      width: max-content;
      animation: gandr-ltr 65s linear infinite;
      will-change: transform;
    }
    .gandr-track-2 {
      display: flex;
      width: max-content;
      animation: gandr-ltr 80s linear infinite;
      will-change: transform;
    }
    .gandr-track-1:hover,
    .gandr-track-2:hover {
      animation-play-state: paused;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-900 antialiased selection:bg-red-600 selection:text-white min-h-screen flex flex-col relative overflow-x-hidden">

  <!-- Background Environmental Texture -->
  <div class="fixed inset-0 z-0 pointer-events-none overflow-hidden" aria-hidden="true">
    <div class="absolute inset-0 bg-[url('/images/telkomschools.jpg')] bg-cover bg-center bg-no-repeat blur-2xl scale-105 opacity-20"></div>
    <div class="absolute inset-0 bg-slate-50/90 bg-grid-subtle"></div>
  </div>

  <!-- 2. Sticky Glass Navigation Bar -->
  <nav class="sticky top-0 z-40 w-full bg-white/90 backdrop-blur-md transition-all duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 sm:py-4 flex items-center justify-between gap-3 sm:gap-6">
      
      <!-- Brand Wordmark -->
      <a href="/" class="group focus:outline-none py-1">
        <span class="text-2xl font-extrabold text-slate-900 tracking-tight hover:opacity-90 transition-opacity">Moklet<span class="text-red-600">Care</span></span>
      </a>

      <!-- Desktop Nav Links -->
      <div class="hidden lg:flex items-center gap-3.5 xl:gap-6 2xl:gap-8 text-xs lg:text-[13px] xl:text-sm font-medium text-slate-600">
        <a href="#masalah" class="hover:text-red-600 transition-colors">Tentang</a>
        <a href="#alur" class="hover:text-red-600 transition-colors">Cara Kerja</a>
        <a href="#peran" class="hover:text-red-600 transition-colors">Pengguna</a>
        <a href="#preview" class="hover:text-red-600 transition-colors">Tampilan</a>
      </div>

      <!-- Action Buttons / Session Status -->
      <% if (locals.user) { %>
        <div class="hidden sm:flex items-center gap-2 sm:gap-3">
          <div class="flex items-center gap-2 lg:gap-3 pl-2">
            <div class="text-right hidden xl:block">
              <div class="text-xs font-bold text-slate-800 truncate max-w-[120px] lg:max-w-[160px]"><%= user.displayName %></div>
              <span class="text-[10px] font-mono-code uppercase px-1.5 py-0.5 bg-slate-100 text-slate-700"><%= user.role %></span>
            </div>
            <% if (user.role === "admin") { %>
              <a href="/admin/approval" class="hidden 2xl:inline-flex text-xs bg-red-600 hover:bg-red-700 text-white font-semibold px-3 py-2 transition-colors">
                Persetujuan
              </a>
            <% } %>

            <a href="/report" class="text-xs bg-red-600 hover:bg-red-700 text-white font-semibold px-3 sm:px-3.5 py-2 transition-colors shrink-0">
              Buat Laporan
            </a>
            <a href="/history" class="hidden md:inline-flex text-xs bg-white hover:bg-slate-50 text-slate-700 font-semibold px-3 py-2 transition-colors shrink-0">
              Riwayat
            </a>
            <a href="/logout" title="Keluar" class="text-xs text-red-600 hover:bg-red-50 p-2 transition-colors shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
            </a>
          </div>
        </div>
      <% } %>

      <!-- Mobile Hamburger Toggle -->
      <button type="button" id="mobile-menu-btn" class="lg:hidden p-2 text-slate-700 hover:bg-slate-100 focus:outline-none shrink-0" aria-label="Toggle Menu">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>

    </div>
  </nav>

  <!-- Mobile Navigation True Overlay -->
  <div id="mobile-menu-overlay" class="fixed inset-0 z-50 hidden lg:hidden" aria-modal="true" role="dialog">
    <!-- Dimmer Backdrop -->
    <div id="mobile-backdrop" class="fixed inset-0 bg-slate-950/50 backdrop-blur-sm transition-opacity"></div>

    <!-- Full-Width Top-Stuck Overlay Sheet -->
    <div class="fixed top-0 inset-x-0 w-full bg-white z-10">
      
      <!-- Top Bar: Logo & Close Button (matches sticky navbar height & layout) -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 sm:py-4 flex items-center justify-between gap-3 sm:gap-6">
        <a href="/" class="group focus:outline-none close-overlay-link py-1">
          <span class="text-2xl font-extrabold text-slate-900 tracking-tight hover:opacity-90 transition-opacity">Moklet<span class="text-red-600">Care</span></span>
        </a>
        <button type="button" id="mobile-close-btn" class="p-2 text-slate-700 hover:bg-slate-100 focus:outline-none shrink-0" aria-label="Tutup Menu">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <!-- Menu List: Full Available Width -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 space-y-1">
        <a href="#masalah" class="close-overlay-link flex items-center justify-between px-3 py-2.5 text-sm font-semibold text-slate-700 hover:text-red-600 hover:bg-slate-50 transition-colors">
          <span>Tentang</span>
          <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
        <a href="#alur" class="close-overlay-link flex items-center justify-between px-3 py-2.5 text-sm font-semibold text-slate-700 hover:text-red-600 hover:bg-slate-50 transition-colors">
          <span>Cara Kerja</span>
          <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
        <a href="#peran" class="close-overlay-link flex items-center justify-between px-3 py-2.5 text-sm font-semibold text-slate-700 hover:text-red-600 hover:bg-slate-50 transition-colors">
          <span>Pengguna</span>
          <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
        <a href="#preview" class="close-overlay-link flex items-center justify-between px-3 py-2.5 text-sm font-semibold text-slate-700 hover:text-red-600 hover:bg-slate-50 transition-colors">
          <span>Tampilan</span>
          <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>

      <!-- Mobile Session & Actions Footer -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-4 bg-slate-50/70 space-y-2">
        <% if (locals.user) { %>
          <div class="flex items-center justify-between px-1 pb-2">
            <div>
              <div class="text-xs font-bold text-slate-800"><%= user.displayName %></div>
              <div class="text-[10px] text-slate-500 font-mono-code"><%= user.email || '' %></div>
            </div>
            <span class="text-[10px] font-mono-code uppercase px-2 py-0.5 bg-white text-slate-700"><%= user.role %></span>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <a href="/report" class="close-overlay-link flex items-center justify-center gap-1.5 py-2.5 px-3 bg-red-600 text-white text-xs font-semibold text-center hover:bg-red-700 transition-colors">
              <span>Buat Laporan</span>
            </a>
            <a href="/history" class="close-overlay-link flex items-center justify-center gap-1.5 py-2.5 px-3 bg-white text-slate-700 text-xs font-semibold text-center hover:bg-slate-100 transition-colors">
              <span>Riwayat Laporan</span>
            </a>
          </div>
          <% if (user.role === "admin") { %>
            <a href="/admin/approval" class="close-overlay-link flex items-center justify-center gap-1.5 w-full py-2.5 px-3 bg-slate-900 text-white text-xs font-semibold text-center hover:bg-slate-800 transition-colors mt-2">
              <span>Pusat Persetujuan Sarpras</span>
            </a>
          <% } %>
          <% if (user.role === "admin" || user.role === "staff") { %>
            <a href="/dashboard" class="close-overlay-link flex items-center justify-center gap-1.5 w-full py-2.5 px-3 bg-slate-100 text-slate-800 text-xs font-semibold text-center hover:bg-slate-200 transition-colors mt-1">
              <span>Dashboard Pemeliharaan</span>
            </a>
          <% } %>
          <div class="pt-2 text-center">
            <a href="/logout" class="close-overlay-link text-xs text-red-600 hover:text-red-700 font-medium inline-flex items-center gap-1">
              <span>Keluar</span>
            </a>
          </div>
        <% } else { %>
          <div class="space-y-2">
            <a href="/report" class="close-overlay-link flex items-center justify-center gap-1.5 w-full py-2.5 px-4 bg-red-600 text-white text-xs font-semibold text-center hover:bg-red-700 transition-colors">
              <span>Buat Laporan</span>
            </a>
            <a href="/login" class="close-overlay-link flex items-center justify-center gap-1.5 w-full py-2.5 px-4 bg-white text-slate-700 text-xs font-semibold text-center hover:bg-slate-100 transition-colors">
              <span>Masuk</span>
            </a>
          </div>
        <% } %>
      </div>

    </div>
  </div>

  <!-- 3. HERO SECTION -->
  <section class="relative z-10 pt-8 pb-14 sm:pt-14 sm:pb-18 md:pt-20 md:pb-24 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center space-y-6">
      
      <!-- Hero Headline -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.15]">
        Inovasi Cerdas Fasilitas Sekolah, <span class="text-red-600">Setiap Laporan Tertangani Tuntas.</span>
      </h1>

      <!-- Narrative Description -->
      <p class="text-slate-600 text-sm sm:text-base md:text-lg leading-relaxed max-w-2xl mx-auto font-medium px-2">
        MokletCare hadir sebagai terobosan digital untuk mentransformasi tata kelola sarana & prasarana. Menggagas alur pelaporan modern berfoto bukti, koordinasi tanggap teknisi, hingga transparansi perbaikan yang tuntas dan terpercaya—menggantikan koordinasi manual yang rentan tercecer.
      </p>

      <!-- CTA Action Cluster -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
        <a href="/report" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-red-600 hover:bg-red-700 text-white text-sm font-semibold px-6 py-3.5 transition-all hover:-translate-y-0.5 focus:outline-none">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          <span>Laporkan Kerusakan Fasilitas</span>
        </a>
        <a href="https://github.com/Ahnaf-icprpl/MokletCare" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-white hover:bg-slate-100 text-slate-800 text-sm font-semibold px-6 py-3.5 shadow-sm transition-all hover:-translate-y-0.5 focus:outline-none">
          <svg class="w-4 h-4 text-slate-700" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
          <span>Open GitHub</span>
        </a>
    </div>

    <!-- Live Operational Telemetry Bar -->
    <div class="max-w-5xl mx-auto mt-8 sm:mt-10">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-5">
        <div class="p-5 sm:p-7 bg-white/80 backdrop-blur-sm shadow-sm text-center flex flex-col items-center justify-center">
          <div class="font-mono-code text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 leading-none">42</div>
          <div class="text-xs sm:text-sm text-slate-600 font-medium mt-2">Total Laporan Masuk</div>
        </div>
        <div class="p-5 sm:p-7 bg-white/80 backdrop-blur-sm shadow-sm text-center flex flex-col items-center justify-center">
          <div class="font-mono-code text-3xl sm:text-4xl lg:text-5xl font-extrabold text-emerald-600 leading-none">29</div>
          <div class="text-xs sm:text-sm text-slate-600 font-medium mt-2">Perbaikan Tuntas</div>
        </div>
        <div class="p-5 sm:p-7 bg-white/80 backdrop-blur-sm shadow-sm text-center flex flex-col items-center justify-center">
          <div class="font-mono-code text-3xl sm:text-4xl lg:text-5xl font-extrabold text-amber-600 leading-none">10</div>
          <div class="text-xs sm:text-sm text-slate-600 font-medium mt-2">Dalam Penanganan</div>
        </div>
        <div class="p-5 sm:p-7 bg-white/80 backdrop-blur-sm shadow-sm text-center flex flex-col items-center justify-center">
          <div class="font-mono-code text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 leading-none">93%</div>
          <div class="text-xs sm:text-sm text-slate-600 font-medium mt-2">Tingkat Penanganan</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. SECTION: PROBLEM VS SOLUTION ("Tantangan & Transformasi Sarpras") -->
  <section id="masalah" class="relative z-10 py-12 sm:py-16 md:py-20 px-4 sm:px-6 lg:px-8 bg-white">
    <div class="max-w-7xl mx-auto space-y-12">
      
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto space-y-3">

        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Mengapa Pengelolaan Fasilitas Membutuhkan Pendekatan Baru?
        </h2>
        <p class="text-slate-600 text-sm sm:text-base font-light">
          Dengan puluhan laboratorium komputer dan fasilitas belajar berintensitas tinggi di SMK Telkom Malang, inovasi sistem digital dirancang untuk mengakhiri cara lama yang rentan tercecer dan kurang terkoordinasi.
        </p>
      </div>

      <!-- Side-by-Side Comparison Matrix -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <!-- Left Column: Cara Lama (Pain Points) -->
        <div class="bg-red-50/40 p-6 sm:p-8 space-y-5">
          <div class="flex items-center gap-3 pb-4">
            <div class="w-8 h-8 bg-red-100 text-red-700 flex items-center justify-center font-bold text-sm">
              ✕
            </div>
            <div>
              <h3 class="text-base font-bold text-red-950">Metode Manual (Pesan Singkat & Kertas)</h3>
              <p class="text-xs text-red-700">Rentan hilang, tanpa format baku, dan sulit dipantau</p>
            </div>
          </div>

          <ul class="space-y-4 text-sm text-slate-700">
            <li class="flex items-start gap-3">
              <span class="text-red-500 font-bold text-base leading-none mt-0.5">•</span>
              <div>
                <strong class="text-slate-900">Laporan Tertimbun & Terlupakan:</strong>
                <p class="text-xs text-slate-600 mt-0.5">Pesan kerusakan di grup obrolan cepat tenggelam oleh percakapan lain sehingga perbaikan sering terabaikan berminggu-minggu.</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-red-500 font-bold text-base leading-none mt-0.5">•</span>
              <div>
                <strong class="text-slate-900">Deskripsi Ambigu & Tanpa Lokasi Jelas:</strong>
                <p class="text-xs text-slate-600 mt-0.5">Laporan singkat seperti "komputer di lab rusak" membuat petugas bingung menentukan ruang, nomor perangkat, dan perkakas yang harus dibawa.</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-red-500 font-bold text-base leading-none mt-0.5">•</span>
              <div>
                <strong class="text-slate-900">Status Penanganan Tidak Terlihat bagi Pelapor:</strong>
                <p class="text-xs text-slate-600 mt-0.5">Siswa dan guru tidak tahu apakah laporannya sudah dibaca, menunggu suku cadang, atau sedang ditangani.</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-red-500 font-bold text-base leading-none mt-0.5">•</span>
              <div>
                <strong class="text-slate-900">Tanpa Bukti Fisik Saat Perbaikan Selesai:</strong>
                <p class="text-xs text-slate-600 mt-0.5">Tidak ada dokumentasi foto resmi saat pengerjaan ditutup, menyulitkan pertanggungjawaban kondisi fasilitas sekolah.</p>
              </div>
            </li>
          </ul>
        </div>

        <!-- Right Column: Standar MokletCare -->
        <div class="bg-emerald-50/40 p-6 sm:p-8 space-y-5">
          <div class="flex items-center gap-3 pb-4">
            <div class="w-8 h-8 bg-emerald-100 text-emerald-800 flex items-center justify-center font-bold text-sm">
              ✓
            </div>
            <div>
              <h3 class="text-base font-bold text-emerald-950">Inovasi Terpadu MokletCare</h3>
              <p class="text-xs text-emerald-700">Terpusat, tervalidasi foto, dan akuntabel di setiap langkah</p>
            </div>
          </div>

          <ul class="space-y-4 text-sm text-slate-700">
            <li class="flex items-start gap-3">
              <span class="text-emerald-600 font-bold text-base leading-none mt-0.5">•</span>
              <div>
                <strong class="text-slate-900">Laporan Digital dengan Nomor Referensi Unik:</strong>
                <p class="text-xs text-slate-600 mt-0.5">Setiap laporan tersimpan rapi secara digital dengan nomor tiket unik, waktu pencatatan, dan jejak status yang jelas.</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-emerald-600 font-bold text-base leading-none mt-0.5">•</span>
              <div>
                <strong class="text-slate-900">Klasifikasi Terstruktur & Lengkap:</strong>
                <p class="text-xs text-slate-600 mt-0.5">Pilihan terarah untuk lokasi ruangan, jenis fasilitas, nama barang, tipe kendala, dan tingkat kepentingan membantu persiapan perbaikan lebih tepat.</p>
              </div>
