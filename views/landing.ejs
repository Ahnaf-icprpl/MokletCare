  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MokletCare — Facility Damage Reporting Portal</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: #f8fafc; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
    @keyframes fadeInUp { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @keyframes pulse-slow { 0%, 100% { opacity: 0.6; } 50% { opacity: 1; } }
    .animate-float { animation: float 4s ease-in-out infinite; }
    .animate-fade-in-up { animation: fadeInUp 0.7s ease-out forwards; }
    .animate-fade-in { animation: fadeIn 0.5s ease-out forwards; }
    .animate-pulse-slow { animation: pulse-slow 3s ease-in-out infinite; }
    .delay-100 { animation-delay: 0.1s; }
    .delay-200 { animation-delay: 0.2s; }
    .delay-300 { animation-delay: 0.3s; }
    .delay-400 { animation-delay: 0.4s; }
    .delay-500 { animation-delay: 0.5s; }
    .stagger > * { opacity: 0; }
  </style>
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen relative overflow-x-hidden">

  <!-- Background Image (blurred telkomschools logo) -->
  <div class="fixed inset-0 z-0 pointer-events-none overflow-hidden">
    <div class="absolute inset-0 bg-[url('/images/telkomschools.jpg')] bg-cover bg-center bg-no-repeat blur-xl scale-110 opacity-30"></div>
    <div class="absolute inset-0 bg-slate-50/80"></div>
  </div>

  <!-- ======== NAVBAR ======== -->
  <nav class="relative z-20 w-full">
    <div class="max-w-6xl mx-auto px-6 py-5 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2.5">
        <div class="w-9 h-9 bg-red-600 rounded-xl flex items-center justify-center">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
        </div>
        <span class="text-xl font-extrabold text-slate-900 tracking-tight">Moklet<span class="text-red-600">Care</span></span>
      </a>
      <div class="flex items-center gap-3">
        <a href="#features" class="hidden sm:inline-block text-sm text-slate-600 hover:text-slate-900 font-medium transition-colors px-3 py-1.5">Features</a>
        <a href="#how-it-works" class="hidden sm:inline-block text-sm text-slate-600 hover:text-slate-900 font-medium transition-colors px-3 py-1.5">How It Works</a>
        <a href="#team" class="hidden sm:inline-block text-sm text-slate-600 hover:text-slate-900 font-medium transition-colors px-3 py-1.5">Team</a>
        <a href="<%= locals.isAuthenticated ? '/report' : '/login' %>" class="text-sm bg-red-600 hover:bg-red-700 text-white font-semibold px-5 py-2.5 rounded-xl transition-colors">
          <%= locals.isAuthenticated ? 'Go to App' : 'Get Started' %>
        </a>
      </div>
    </div>
  </nav>

  <!-- ======== HERO SECTION ======== -->
  <section class="relative z-10 pt-12 pb-20 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-16">
        <!-- Left: Text Content -->
        <div class="flex-1 text-center lg:text-left stagger">
          <div class="animate-fade-in-up inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-red-50 border border-red-100 text-red-600 text-xs font-semibold mb-6">
            <span class="w-2 h-2 bg-red-500 rounded-full animate-pulse-slow"></span>
            SMK Telkom Malang — ITECHNO CUP 2026
          </div>
          <h1 class="animate-fade-in-up delay-100 text-4xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-[1.1] mb-6">
            Report Facility<br>
            Damage <span class="text-red-600">Instantly</span>
          </h1>
          <p class="animate-fade-in-up delay-200 text-lg sm:text-xl text-slate-500 font-light leading-relaxed max-w-xl mx-auto lg:mx-0 mb-8">
            Empowering students and staff to maintain a safe, functional school environment. One report at a time.
          </p>
          <div class="animate-fade-in-up delay-300 flex flex-col sm:flex-row items-center gap-4 justify-center lg:justify-start">
            <a href="<%= locals.isAuthenticated ? '/report' : '/login' %>" class="w-full sm:w-auto bg-red-600 hover:bg-red-700 text-white font-bold px-8 py-4 rounded-xl transition-all text-center flex items-center justify-center gap-2.5 text-base">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
              <%= locals.isAuthenticated ? 'Go to App' : 'Start Reporting Now' %>
            </a>
            <a href="#how-it-works" class="w-full sm:w-auto bg-white hover:bg-slate-50 text-slate-700 font-semibold px-8 py-4 rounded-xl transition-all border border-slate-200 text-center text-base">
              Learn How It Works
            </a>
          </div>
        </div>

        <!-- Right: Illustration / Visual -->
        <div class="flex-1 animate-fade-in delay-400">
          <div class="relative max-w-md mx-auto">
            <!-- Floating cards mockup -->
            <div class="bg-white/90 backdrop-blur-xl border border-slate-200 rounded-2xl p-6 animate-float">
              <!-- Mini report card -->
              <div class="flex items-center gap-3 mb-5">
                <div class="w-10 h-10 rounded-full bg-red-100 flex items-center justify-center">
                  <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"></path></svg>
                </div>
                <div>
                  <div class="text-sm font-bold text-slate-800">New Damage Report</div>
                  <div class="text-xs text-slate-500">Lab RPL 1 • Just now</div>
                </div>
                <span class="ml-auto px-2.5 py-1 rounded-lg bg-amber-50 text-amber-700 text-[10px] font-bold border border-amber-200">PENDING</span>
              </div>
              <div class="space-y-3">
                <div class="flex items-center gap-2.5 text-xs">
                  <span class="w-7 h-7 rounded-lg bg-blue-50 flex items-center justify-center"><svg class="w-3.5 h-3.5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg></span>
                  <span class="text-slate-600">Location: <strong class="text-slate-800">Lab RPL 1</strong></span>
                </div>
                <div class="flex items-center gap-2.5 text-xs">
                  <span class="w-7 h-7 rounded-lg bg-red-50 flex items-center justify-center"><svg class="w-3.5 h-3.5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg></span>
                  <span class="text-slate-600">Urgency: <strong class="text-red-600">High</strong></span>
                </div>
                <div class="flex items-center gap-2.5 text-xs">
                  <span class="w-7 h-7 rounded-lg bg-emerald-50 flex items-center justify-center"><svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></span>
                  <span class="text-slate-600">Status: <strong class="text-emerald-600">Photo Verified</strong></span>
                </div>
              </div>
              <div class="mt-5 pt-4 border-t border-slate-100 flex items-center gap-2">
                <div class="flex -space-x-2">
                  <div class="w-6 h-6 rounded-full bg-red-200 border-2 border-white flex items-center justify-center text-[9px] font-bold text-red-700">A</div>
                  <div class="w-6 h-6 rounded-full bg-blue-200 border-2 border-white flex items-center justify-center text-[9px] font-bold text-blue-700">R</div>
                  <div class="w-6 h-6 rounded-full bg-emerald-200 border-2 border-white flex items-center justify-center text-[9px] font-bold text-emerald-700">B</div>
                </div>
                <span class="text-[10px] text-slate-400">Team reviewing</span>
              </div>
            </div>

            <!-- Small floating badge -->
            <div class="absolute -top-3 -right-3 bg-emerald-500 text-white text-[10px] font-bold px-3 py-1.5 rounded-lg" style="animation: float 3s ease-in-out infinite 0.5s;">
              ✓ Resolved
            </div>
            <div class="absolute -bottom-3 -left-3 bg-white border border-slate-200 text-slate-700 text-[10px] font-semibold px-3 py-1.5 rounded-lg" style="animation: float 3.5s ease-in-out infinite 1s;">
              📸 Photo Required
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ======== STATS BAR ======== -->
  <section class="relative z-10 py-10 px-6">
    <div class="max-w-5xl mx-auto">
      <div class="bg-white/80 backdrop-blur-xl border border-slate-200 rounded-2xl p-8 grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <div class="text-3xl font-black text-red-600 mb-1">3</div>
          <div class="text-xs text-slate-500 font-medium">User Roles</div>
        </div>
        <div>
          <div class="text-3xl font-black text-red-600 mb-1">100%</div>
          <div class="text-xs text-slate-500 font-medium">Photo Verified</div>
        </div>
        <div>
          <div class="text-3xl font-black text-red-600 mb-1">Real-time</div>
          <div class="text-xs text-slate-500 font-medium">Status Tracking</div>
        </div>
        <div>
          <div class="text-3xl font-black text-red-600 mb-1">Secure</div>
          <div class="text-xs text-slate-500 font-medium">Google SSO Auth</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ======== FEATURES SECTION ======== -->
  <section id="features" class="relative z-10 py-16 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-14">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-red-50 text-red-600 mb-4 border border-red-100">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path></svg>
          Features
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">Everything You Need</h2>
        <p class="text-slate-500 text-lg max-w-2xl mx-auto font-light">A complete facility management system designed for the SMK Telkom Malang community.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Feature 1 -->
        <div class="bg-white/80 backdrop-blur-xl border border-slate-200 rounded-2xl p-7 hover:border-red-200 transition-all group">
          <div class="w-12 h-12 rounded-xl bg-red-50 flex items-center justify-center mb-5 group-hover:bg-red-100 transition-colors">
            <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"></path></svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Quick Damage Reports</h3>
          <p class="text-sm text-slate-500 leading-relaxed">Submit facility damage reports in seconds with guided forms — select the room, facility type, damage category, and urgency level.</p>
        </div>

        <!-- Feature 2 -->
        <div class="bg-white/80 backdrop-blur-xl border border-slate-200 rounded-2xl p-7 hover:border-red-200 transition-all group">
          <div class="w-12 h-12 rounded-xl bg-blue-50 flex items-center justify-center mb-5 group-hover:bg-blue-100 transition-colors">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Photo Verification</h3>
          <p class="text-sm text-slate-500 leading-relaxed">Every report requires photo evidence. Staff can request updated photos and verify repairs with before-and-after documentation.</p>
        </div>

        <!-- Feature 3 -->
        <div class="bg-white/80 backdrop-blur-xl border border-slate-200 rounded-2xl p-7 hover:border-red-200 transition-all group">
          <div class="w-12 h-12 rounded-xl bg-emerald-50 flex items-center justify-center mb-5 group-hover:bg-emerald-100 transition-colors">
            <svg class="w-6 h-6 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Secure SSO Login</h3>
          <p class="text-sm text-slate-500 leading-relaxed">Sign in securely with your Google account. No passwords to remember — powered by Clerk authentication with enterprise-grade security.</p>
        </div>

        <!-- Feature 4 -->
        <div class="bg-white/80 backdrop-blur-xl border border-slate-200 rounded-2xl p-7 hover:border-red-200 transition-all group">
          <div class="w-12 h-12 rounded-xl bg-amber-50 flex items-center justify-center mb-5 group-hover:bg-amber-100 transition-colors">
            <svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path></svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Role-Based Access</h3>
          <p class="text-sm text-slate-500 leading-relaxed">Three distinct roles — Reporters submit, Staff manage and update, Admins have full superuser control over the entire system.</p>
        </div>

        <!-- Feature 5 -->
        <div class="bg-white/80 backdrop-blur-xl border border-slate-200 rounded-2xl p-7 hover:border-red-200 transition-all group">
          <div class="w-12 h-12 rounded-xl bg-purple-50 flex items-center justify-center mb-5 group-hover:bg-purple-100 transition-colors">
            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Live Dashboard</h3>
          <p class="text-sm text-slate-500 leading-relaxed">Interactive dashboard with real-time statistics, filterable report tables, status tracking, and one-click report management.</p>
        </div>

        <!-- Feature 6 -->
        <div class="bg-white/80 backdrop-blur-xl border border-slate-200 rounded-2xl p-7 hover:border-red-200 transition-all group">
          <div class="w-12 h-12 rounded-xl bg-cyan-50 flex items-center justify-center mb-5 group-hover:bg-cyan-100 transition-colors">
            <svg class="w-6 h-6 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Full History</h3>
          <p class="text-sm text-slate-500 leading-relaxed">Track every report from submission to resolution. View repair timelines, photo evidence, and complete audit trails.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ======== HOW IT WORKS ======== -->
  <section id="how-it-works" class="relative z-10 py-16 px-6">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-14">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-red-50 text-red-600 mb-4 border border-red-100">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          Simple Process
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">How It Works</h2>
        <p class="text-slate-500 text-lg max-w-2xl mx-auto font-light">From discovery to resolution in four simple steps.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Step 1 -->
        <div class="relative bg-white/80 backdrop-blur-xl border border-slate-200 rounded-2xl p-6 text-center">
          <div class="w-10 h-10 rounded-full bg-red-600 text-white flex items-center justify-center text-sm font-extrabold mx-auto mb-4">1</div>
          <h3 class="text-sm font-bold text-slate-900 mb-2">Sign In</h3>
          <p class="text-xs text-slate-500 leading-relaxed">Authenticate with your Google account in one click. No registration needed.</p>
          <!-- Connector line -->
          <div class="hidden lg:block absolute top-1/2 -right-3 w-6 h-px bg-slate-300"></div>
        </div>

        <!-- Step 2 -->
        <div class="relative bg-white/80 backdrop-blur-xl border border-slate-200 rounded-2xl p-6 text-center">
          <div class="w-10 h-10 rounded-full bg-red-600 text-white flex items-center justify-center text-sm font-extrabold mx-auto mb-4">2</div>
          <h3 class="text-sm font-bold text-slate-900 mb-2">Submit Report</h3>
          <p class="text-xs text-slate-500 leading-relaxed">Fill in the damage details — location, type, urgency — and upload a photo as evidence.</p>
          <div class="hidden lg:block absolute top-1/2 -right-3 w-6 h-px bg-slate-300"></div>
        </div>

        <!-- Step 3 -->
        <div class="relative bg-white/80 backdrop-blur-xl border border-slate-200 rounded-2xl p-6 text-center">
          <div class="w-10 h-10 rounded-full bg-red-600 text-white flex items-center justify-center text-sm font-extrabold mx-auto mb-4">3</div>
          <h3 class="text-sm font-bold text-slate-900 mb-2">Staff Reviews</h3>
          <p class="text-xs text-slate-500 leading-relaxed">Maintenance staff reviews the report, updates the status, and coordinates repairs.</p>
          <div class="hidden lg:block absolute top-1/2 -right-3 w-6 h-px bg-slate-300"></div>
        </div>

        <!-- Step 4 -->
        <div class="bg-white/80 backdrop-blur-xl border border-emerald-200 rounded-2xl p-6 text-center">
          <div class="w-10 h-10 rounded-full bg-emerald-600 text-white flex items-center justify-center text-sm font-extrabold mx-auto mb-4">✓</div>
          <h3 class="text-sm font-bold text-slate-900 mb-2">Issue Resolved</h3>
          <p class="text-xs text-slate-500 leading-relaxed">Repairs completed and verified with photo evidence. Everyone stays informed.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ======== TECH STACK RIBBON ======== -->
  <section class="relative z-10 py-10 px-6">
    <div class="max-w-5xl mx-auto">
      <div class="bg-white/80 backdrop-blur-xl border border-slate-200 rounded-2xl p-8">
        <div class="text-center mb-6">
          <h3 class="text-sm font-bold text-slate-400 uppercase tracking-widest">Built With</h3>
        </div>
        <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
          <span class="text-sm font-semibold text-slate-600 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-green-500"></span> Node.js
          </span>
          <span class="text-sm font-semibold text-slate-600 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-slate-700"></span> Express
          </span>
          <span class="text-sm font-semibold text-slate-600 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span> PostgreSQL
