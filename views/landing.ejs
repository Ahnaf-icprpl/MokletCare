<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <!-- Google Analytics: Enabled in Production, zero-latency stub in Development -->
  <% const gaId = locals.gaMeasurementId || 'G-6M87BW75P1'; %>
  <% if (process.env.NODE_ENV === 'production' && gaId) { %>
    <script async src="https://www.googletagmanager.com/gtag/js?id=<%= gaId %>"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', '<%= gaId %>', {
        page_title: '<%= title %>',
        page_path: window.location.pathname
      });
    </script>
  <% } else { %>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){/* Dev environment: local telemetry stub */}
    </script>
  <% } %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="MokletCare — Sistem Pelaporan Insiden dan Manajemen Pemeliharaan Fasilitas Sekolah Terpadu untuk SMK Telkom Malang. Dibuat untuk ITECHNO CUP 2026.">
  <title><%= title %></title>
  <link rel="stylesheet" href="/stylesheets/style.css?v=<%= locals.assetVersion || '2.0.4' %>">
  
  <!-- Typography: Plus Jakarta Sans & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after {
      box-shadow: none !important;
      text-shadow: none !important;
      -webkit-box-shadow: none !important;
    }
    body {
      font-family: "Plus Jakarta Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    .font-mono-code {
      font-family: "JetBrains Mono", monospace;
    }
    .bg-grid-subtle {
      background-size: 32px 32px;
      background-image: 
        linear-gradient(to right, rgba(15, 23, 42, 0.04) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(15, 23, 42, 0.04) 1px, transparent 1px);
    }
    ::-webkit-scrollbar {
      width: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #f8fafc;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-900 antialiased selection:bg-red-600 selection:text-white min-h-screen flex flex-col relative overflow-x-hidden">

  <!-- Background Environmental Texture -->
  <div class="fixed inset-0 z-0 pointer-events-none overflow-hidden" aria-hidden="true">
    <div class="absolute inset-0 bg-[url('/images/telkomschools.jpg')] bg-cover bg-center bg-no-repeat blur-2xl scale-105 opacity-20"></div>
    <div class="absolute inset-0 bg-slate-50/90 bg-grid-subtle"></div>
  </div>

  <!-- 2. Sticky Glass Navigation Bar -->
  <nav class="sticky top-0 z-40 w-full bg-white/90 backdrop-blur-md border-b border-slate-200/90 transition-all duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 sm:py-4 flex items-center justify-between gap-3 sm:gap-6">
      
      <!-- Brand Wordmark -->
      <a href="/" class="group focus:outline-none py-1">
        <span class="text-2xl font-extrabold text-slate-900 tracking-tight hover:opacity-90 transition-opacity">Moklet<span class="text-red-600">Care</span></span>
      </a>

      <!-- Desktop Nav Links -->
      <div class="hidden lg:flex items-center gap-3.5 xl:gap-6 2xl:gap-8 text-xs lg:text-[13px] xl:text-sm font-medium text-slate-600">
        <a href="#masalah" class="hover:text-red-600 transition-colors">Tantangan</a>
        <a href="#alur" class="hover:text-red-600 transition-colors">Alur Sarpras</a>
        <a href="#peran" class="hover:text-red-600 transition-colors">Tiga Peran</a>
        <a href="#arsitektur" class="hover:text-red-600 transition-colors">Arsitektur</a>
        <a href="#preview" class="hover:text-red-600 transition-colors">Screenshots</a>
        <a href="#faq" class="hover:text-red-600 transition-colors">FAQ</a>
      </div>

      <!-- Action Buttons / Session Status -->
      <% if (locals.user) { %>
        <div class="hidden sm:flex items-center gap-2 sm:gap-3">
          <div class="flex items-center gap-2 lg:gap-3 pl-2 sm:border-l border-slate-200">
            <div class="text-right hidden xl:block">
              <div class="text-xs font-bold text-slate-800 truncate max-w-[120px] lg:max-w-[160px]"><%= user.displayName %></div>
              <span class="text-[10px] font-mono-code uppercase px-1.5 py-0.5 rounded bg-slate-100 text-slate-700 border border-slate-200"><%= user.role %></span>
            </div>
            <% if (user.role === "admin") { %>
              <a href="/admin/approval" class="hidden 2xl:inline-flex text-xs bg-red-600 hover:bg-red-700 text-white font-semibold px-3 py-2 rounded-lg transition-colors">
                Approval Sarpras
              </a>
            <% } %>

            <a href="/report" class="text-xs bg-red-600 hover:bg-red-700 text-white font-semibold px-3 sm:px-3.5 py-2 rounded-lg transition-colors shrink-0">
              Lapor Fasilitas
            </a>
            <a href="/history" class="hidden md:inline-flex text-xs bg-white hover:bg-slate-50 text-slate-700 font-semibold px-3 py-2 rounded-lg transition-colors border border-slate-200 shrink-0">
              Riwayat
            </a>
            <a href="/logout" title="Keluar dari sesi" class="text-xs text-red-600 hover:bg-red-50 p-2 rounded-lg border border-red-200 transition-colors shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
            </a>
          </div>
        </div>
      <% } %>

      <!-- Mobile Hamburger Toggle -->
      <button type="button" id="mobile-menu-btn" class="lg:hidden p-2 rounded-lg border border-slate-200 text-slate-700 hover:bg-slate-100 focus:outline-none shrink-0" aria-label="Toggle Menu">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>

    </div>
  </nav>

  <!-- Mobile Navigation True Overlay -->
  <div id="mobile-menu-overlay" class="fixed inset-0 z-50 hidden lg:hidden" aria-modal="true" role="dialog">
    <!-- Dimmer Backdrop -->
    <div id="mobile-backdrop" class="fixed inset-0 bg-slate-950/50 backdrop-blur-sm transition-opacity"></div>

    <!-- Full-Width Top-Stuck Overlay Sheet -->
    <div class="fixed top-0 inset-x-0 w-full bg-white border-b border-slate-200 z-10">
      
      <!-- Top Bar: Logo & Close Button (matches sticky navbar height & layout) -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 sm:py-4 flex items-center justify-between gap-3 sm:gap-6 border-b border-slate-100">
        <a href="/" class="group focus:outline-none close-overlay-link py-1">
          <span class="text-2xl font-extrabold text-slate-900 tracking-tight hover:opacity-90 transition-opacity">Moklet<span class="text-red-600">Care</span></span>
        </a>
        <button type="button" id="mobile-close-btn" class="p-2 rounded-lg border border-slate-200 text-slate-700 hover:bg-slate-100 focus:outline-none shrink-0" aria-label="Tutup Menu">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <!-- Menu List: Full Available Width -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 space-y-1">
        <a href="#masalah" class="close-overlay-link flex items-center justify-between px-3 py-2.5 text-sm font-semibold text-slate-700 hover:text-red-600 hover:bg-slate-50 rounded-xl transition-colors">
          <span>Tantangan</span>
          <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
        <a href="#alur" class="close-overlay-link flex items-center justify-between px-3 py-2.5 text-sm font-semibold text-slate-700 hover:text-red-600 hover:bg-slate-50 rounded-xl transition-colors">
          <span>Alur Sarpras</span>
          <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
        <a href="#peran" class="close-overlay-link flex items-center justify-between px-3 py-2.5 text-sm font-semibold text-slate-700 hover:text-red-600 hover:bg-slate-50 rounded-xl transition-colors">
          <span>Tiga Peran</span>
          <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
        <a href="#arsitektur" class="close-overlay-link flex items-center justify-between px-3 py-2.5 text-sm font-semibold text-slate-700 hover:text-red-600 hover:bg-slate-50 rounded-xl transition-colors">
          <span>Arsitektur</span>
          <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
        <a href="#preview" class="close-overlay-link flex items-center justify-between px-3 py-2.5 text-sm font-semibold text-slate-700 hover:text-red-600 hover:bg-slate-50 rounded-xl transition-colors">
          <span>Screenshots</span>
          <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
        <a href="#faq" class="close-overlay-link flex items-center justify-between px-3 py-2.5 text-sm font-semibold text-slate-700 hover:text-red-600 hover:bg-slate-50 rounded-xl transition-colors">
          <span>FAQ</span>
          <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>

    </div>
  </div>

  <!-- 3. HERO SECTION -->
  <section class="relative z-10 pt-8 pb-14 sm:pt-14 sm:pb-18 md:pt-20 md:pb-24 px-4 sm:px-6 lg:px-8 border-b border-slate-200/80">
    <div class="max-w-4xl mx-auto text-center space-y-6">
      
      <!-- Hero Headline -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.15]">
        Infrastruktur Sekolah Terkendali, <span class="text-red-600">Setiap Laporan Tertangani.</span>
      </h1>

      <!-- Narrative Description -->
      <p class="text-slate-600 text-sm sm:text-base md:text-lg leading-relaxed max-w-2xl mx-auto font-light px-2">
        Tidak ada lagi aduan fasilitas yang terselip di grup obrolan. <strong class="font-semibold text-slate-800">MokletCare</strong> mendigitalisasi tata kelola sarana & prasarana SMK Telkom Malang—mulai dari pelaporan instan berfoto bukti, penanganan teknisi tanggap, hingga verifikasi perbaikan yang tuntas dan transparan.
      </p>

      <!-- CTA Action Cluster -->
      <div class="flex items-center justify-center pt-2">
        <a href="/report" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-red-600 hover:bg-red-700 text-white text-sm font-semibold px-6 py-3.5 rounded-xl transition-all hover:-translate-y-0.5 focus:outline-none">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          <span>Laporkan Kerusakan Fasilitas</span>
        </a>
      </div>

      <!-- Live Operational Telemetry Bar -->
      <div class="pt-8 mt-4 border-t border-slate-200">
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
          <div class="p-3 sm:p-4 bg-white/70 rounded-xl border border-slate-200 text-center">
            <div class="font-mono-code text-2xl font-bold text-slate-900"><%= stats.total %></div>
            <div class="text-[11px] text-slate-500 font-medium mt-0.5">Total Laporan Masuk</div>
          </div>
          <div class="p-4 bg-white/70 rounded-xl border border-slate-200">
            <div class="font-mono-code text-2xl font-bold text-emerald-600"><%= stats.resolved %></div>
            <div class="text-[11px] text-slate-500 font-medium mt-0.5">Fasilitas Selesai</div>
          </div>
          <div class="p-4 bg-white/70 rounded-xl border border-slate-200">
            <div class="font-mono-code text-2xl font-bold text-amber-600"><%= stats.inProgress %></div>
            <div class="text-[11px] text-slate-500 font-medium mt-0.5">Sedang Dikerjakan</div>
          </div>
          <div class="p-4 bg-white/70 rounded-xl border border-slate-200">
            <div class="font-mono-code text-2xl font-bold text-slate-900"><%= stats.resolutionPercent %>%</div>
            <div class="text-[11px] text-slate-500 font-medium mt-0.5">Tingkat Penanganan</div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- 4. SECTION: PROBLEM VS SOLUTION ("Tantangan & Transformasi Sarpras") -->
  <section id="masalah" class="relative z-10 py-12 sm:py-16 md:py-20 px-4 sm:px-6 lg:px-8 border-b border-slate-200 bg-white">
    <div class="max-w-7xl mx-auto space-y-12">
      
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto space-y-3">

        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Mengapa Pesan Grup WhatsApp & Formulir Kertas Tidak Lagi Cukup?
        </h2>
        <p class="text-slate-600 text-sm sm:text-base font-light">
          SMK Telkom Malang memiliki puluhan laboratorium komputer, ratusan perangkat komputasi, dan fasilitas berutilisasi tinggi. Cara lama menghasilkan kekacauan administrasi dan kelambatan perbaikan.
        </p>
      </div>

      <!-- Side-by-Side Comparison Matrix -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <!-- Left Column: Cara Lama (Pain Points) -->
        <div class="bg-red-50/40 border border-red-200/80 rounded-2xl p-6 sm:p-8 space-y-5">
          <div class="flex items-center gap-3 border-b border-red-200/80 pb-4">
            <div class="w-8 h-8 rounded-lg bg-red-100 text-red-700 flex items-center justify-center font-bold text-sm">
              ✕
            </div>
            <div>
              <h3 class="text-base font-bold text-red-950">Metode Tradisional (Chat WA & Kertas)</h3>
              <p class="text-xs text-red-700">Rentan hilang, tanpa standarisasi, tanpa akuntabilitas</p>
            </div>
          </div>

          <ul class="space-y-4 text-sm text-slate-700">
            <li class="flex items-start gap-3">
              <span class="text-red-500 font-bold text-base leading-none mt-0.5">•</span>
              <div>
                <strong class="text-slate-900">Laporan Tertimbun & Terlupakan:</strong>
                <p class="text-xs text-slate-600 mt-0.5">Pesan kerusakan di grup WhatsApp cepat tenggelam oleh ratusan obrolan lain sehingga perbaikan sering terabaikan berminggu-minggu.</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-red-500 font-bold text-base leading-none mt-0.5">•</span>
              <div>
                <strong class="text-slate-900">Deskripsi Ambigu & Tanpa Lokasi Jelas:</strong>
                <p class="text-xs text-slate-600 mt-0.5">Laporan sering hanya berupa "Pak, PC di lab rusak". Teknisi tidak tahu ruang lab mana, PC nomor berapa, dan komponen apa yang harus dibawa.</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-red-500 font-bold text-base leading-none mt-0.5">•</span>
              <div>
                <strong class="text-slate-900">Pelapor Mengalami Ketiadaan Transparansi:</strong>
                <p class="text-xs text-slate-600 mt-0.5">Siswa dan guru tidak tahu apakah laporannya sudah dibaca, ditolak karena tidak ada anggaran, atau sedang ditangani.</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-red-500 font-bold text-base leading-none mt-0.5">•</span>
              <div>
                <strong class="text-slate-900">Tanpa Bukti Fisik Saat Perbaikan Selesai:</strong>
                <p class="text-xs text-slate-600 mt-0.5">Tidak ada dokumentasi visual resmi saat pengerjaan ditutup, menyulitkan audit pertanggungjawaban Sarpras tahunan.</p>
              </div>
            </li>
          </ul>
        </div>

        <!-- Right Column: Standar MokletCare -->
        <div class="bg-emerald-50/40 border border-emerald-200/80 rounded-2xl p-6 sm:p-8 space-y-5">
          <div class="flex items-center gap-3 border-b border-emerald-200/80 pb-4">
            <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-800 flex items-center justify-center font-bold text-sm">
              ✓
            </div>
            <div>
              <h3 class="text-base font-bold text-emerald-950">Standar Sistem MokletCare</h3>
              <p class="text-xs text-emerald-700">Terpusat, tervalidasi foto, dan akuntabel di setiap langkah</p>
            </div>
          </div>

          <ul class="space-y-4 text-sm text-slate-700">
            <li class="flex items-start gap-3">
              <span class="text-emerald-600 font-bold text-base leading-none mt-0.5">•</span>
              <div>
                <strong class="text-slate-900">Tiket Terpusat dengan ID Referensi Unik:</strong>
                <p class="text-xs text-slate-600 mt-0.5">Setiap keluhan tercatat dalam database PostgreSQL dengan nomor tiket unik, waktu masuk, dan riwayat status yang permanen.</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-emerald-600 font-bold text-base leading-none mt-0.5">•</span>
              <div>
                <strong class="text-slate-900">Taksonomi Kerusakan 5 Tingkat Terstruktur:</strong>
                <p class="text-xs text-slate-600 mt-0.5">Dropdown wajib memilih Lokasi Ruang, Jenis Fasilitas, Barang, Tipe Kerusakan, dan Tingkat Urgensi sehingga teknisi siap dengan perkakas yang tepat.</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-emerald-600 font-bold text-base leading-none mt-0.5">•</span>
              <div>
                <strong class="text-slate-900">Transparansi Real-Time di Halaman Riwayat:</strong>
                <p class="text-xs text-slate-600 mt-0.5">Pelapor dapat memeriksa perkembangan tiketnya kapan saja di menu <code class="font-mono-code text-[11px] bg-white px-1.5 py-0.5 rounded border border-emerald-300">/history</code> lengkap dengan catatan staf.</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-emerald-600 font-bold text-base leading-none mt-0.5">•</span>
              <div>
                <strong class="text-slate-900">Bukti Ganda Cloudinary (Sebelum & Sesudah):</strong>
                <p class="text-xs text-slate-600 mt-0.5">Foto awal kerusakan menjadi dasar verifikasi, dan foto hasil pengerjaan diunggah teknisi sebagai bukti sahih sebelum tiket ditutup.</p>
              </div>
            </li>
          </ul>
        </div>

      </div>

    </div>
  </section>

  <!-- 5. SECTION: 4-STAGE OPERATIONAL LIFECYCLE ("Alur Penanganan Sarpras") -->
  <section id="alur" class="relative z-10 py-12 sm:py-16 md:py-20 px-4 sm:px-6 lg:px-8 border-b border-slate-200 bg-slate-50">
    <div class="max-w-7xl mx-auto space-y-12">
      
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Alur Kerja 4 Tahap dari Laporan Hingga Perbaikan Selesai
        </h2>
        <p class="text-slate-600 text-sm sm:text-base font-light">
          Setiap laporan diproses melalui alur kerja baku yang menjamin kecepatan penanganan tanpa mengorbankan kendali anggaran.
        </p>
      </div>

      <!-- 4 Stages Timeline Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Stage 1 -->
        <div class="bg-white rounded-2xl border border-slate-200 p-6 flex flex-col justify-between hover:border-red-300 transition-colors">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="w-8 h-8 rounded-lg bg-red-600 text-white font-mono-code font-bold text-xs flex items-center justify-center">01</span>
              <span class="text-[11px] font-mono-code text-slate-400">INPUT PELAPOR</span>
            </div>
            <h3 class="text-base font-bold text-slate-900">Penginputan Insiden Terstruktur</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Siswa atau guru memilih lokasi ruangan (misal: <em>Lab RPL 1</em>), item yang rusak, jenis kerusakan, melampirkan foto bukti maksimal 5MB, serta menetapkan tingkat urgensi.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-slate-100 text-[11px] text-slate-500 font-mono-code">
            Durasi: <strong class="text-slate-800">&lt; 60 Detik</strong>
          </div>
        </div>

        <!-- Stage 2 -->
        <div class="bg-white rounded-2xl border border-slate-200 p-6 flex flex-col justify-between hover:border-red-300 transition-colors">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="w-8 h-8 rounded-lg bg-slate-900 text-white font-mono-code font-bold text-xs flex items-center justify-center">02</span>
              <span class="text-[11px] font-mono-code text-slate-400">GOVERNANCE</span>
            </div>
