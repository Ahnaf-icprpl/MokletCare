  <!-- Client-side Interactive Behaviors (Vanilla JavaScript) -->
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      
      // 1. Mobile Menu True Overlay Controller
      const mobileBtn = document.getElementById("mobile-menu-btn");
      const mobileOverlay = document.getElementById("mobile-menu-overlay");
      const mobileCloseBtn = document.getElementById("mobile-close-btn");
      const mobileBackdrop = document.getElementById("mobile-backdrop");

      function openMobileMenu() {
        if (!mobileOverlay) return;
        mobileOverlay.classList.remove("hidden");
        document.body.classList.add("overflow-hidden");
      }

      function closeMobileMenu() {
        if (!mobileOverlay) return;
        mobileOverlay.classList.add("hidden");
        document.body.classList.remove("overflow-hidden");
      }

      if (mobileBtn) {
        mobileBtn.addEventListener("click", openMobileMenu);
      }
      if (mobileCloseBtn) {
        mobileCloseBtn.addEventListener("click", closeMobileMenu);
      }
      if (mobileBackdrop) {
        mobileBackdrop.addEventListener("click", closeMobileMenu);
      }

      // Close when clicking any anchor inside the overlay
      document.querySelectorAll(".close-overlay-link").forEach(function(link) {
        link.addEventListener("click", closeMobileMenu);
      });

      // Close on Escape key
      document.addEventListener("keydown", function(e) {
        if (e.key === "Escape" && mobileOverlay && !mobileOverlay.classList.contains("hidden")) {
          closeMobileMenu();
        }
      });

      // Google Analytics Event Helper
      function trackGA(eventName, params) {
        if (typeof gtag === "function") {
          gtag("event", eventName, params || {});
        }
      }

      // Track CTA Clicks
      document.querySelectorAll("a[href='/report'], a[href='/dashboard'], a[href='/login'], a[href='/admin/approval']").forEach(function(anchor) {
        anchor.addEventListener("click", function() {
          trackGA("cta_click", {
            destination: this.getAttribute("href"),
            link_text: this.textContent.trim().slice(0, 50)
          });
        });
      });

      // 2. Screenshot Showcase Tab Switcher
      const tabButtons = document.querySelectorAll(".gallery-tab-btn");
      const tabContents = document.querySelectorAll(".gallery-content");

      tabButtons.forEach(function(button) {
        button.addEventListener("click", function() {
          const targetTabId = this.getAttribute("data-tab");
          
          tabButtons.forEach(function(btn) {
            btn.classList.remove("bg-red-600", "text-white");
            btn.classList.add("bg-slate-100", "text-slate-700");
          });

          this.classList.remove("bg-slate-100", "text-slate-700");
          this.classList.add("bg-red-600", "text-white");

          tabContents.forEach(function(content) {
            if (content.id === targetTabId) {
              content.classList.remove("hidden");
            } else {
              content.classList.add("hidden");
            }
          });

          trackGA("switch_gallery_tab", { tab_id: targetTabId });
        });
      });

      // 4. FAQ Accordion Click-to-Expand
      const faqTriggers = document.querySelectorAll(".faq-trigger");
      faqTriggers.forEach(function(trigger) {
        trigger.addEventListener("click", function() {
          const item = this.closest(".faq-item");
          const answer = item.querySelector(".faq-answer");
          const chevron = item.querySelector(".faq-chevron");
          const isClosed = answer.classList.contains("hidden");

          // Close all answers first
          document.querySelectorAll(".faq-answer").forEach(function(ans) {
            ans.classList.add("hidden");
          });
          document.querySelectorAll(".faq-chevron").forEach(function(chv) {
            chv.classList.remove("rotate-180");
          });

          // Toggle current
          if (isClosed) {
            answer.classList.remove("hidden");
            chevron.classList.add("rotate-180");
            const questionText = item.querySelector(".faq-trigger span") ? item.querySelector(".faq-trigger span").textContent.trim() : "";
            trackGA("expand_faq", { question: questionText.slice(0, 80) });
          }
        });
      });

    });
  </script>

