<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title>My Reports | SMK Telkom Malang</title>
 <link rel="stylesheet" href="/stylesheets/style.css">
 <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
 <style>
 body { font-family: 'Inter', sans-serif; }
 ::-webkit-scrollbar { width: 8px; }
 ::-webkit-scrollbar-track { background: #f8fafc; }
 ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
 ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
 </style>
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col items-center p-6 relative overflow-x-hidden pt-12">
 
 <!-- Background Image -->
 <div class="fixed inset-0 z-0 pointer-events-none overflow-hidden">
 <div class="absolute inset-0 bg-[url('/images/telkomschools.jpg')] bg-cover bg-center bg-no-repeat blur-xl scale-110 opacity-40"></div>
 <div class="absolute inset-0 bg-slate-50/80"></div>
 </div>

 <div class="relative z-10 w-full max-w-4xl">
 
 <% if (success) { %>
 <div class="mb-6 bg-emerald-50 border border-emerald-200 text-emerald-700 px-4 py-3 rounded-xl flex items-center gap-3">
 <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
 <span class="font-medium">Report submitted successfully! You can track its progress below.</span>
 </div>
 <% } %>

 <div class="flex justify-between items-center mb-8">
 <div>
 <h1 class="text-3xl font-extrabold text-slate-800 tracking-tight">My Reports</h1>
 <p class="text-slate-500 mt-1">Track the progress of your submitted facility damage reports.</p>
 </div>
 <div class="flex items-center gap-3">
 <a href="/" class="text-sm bg-white text-slate-600 px-4 py-2 rounded-lg transition-colors border border-slate-200 font-medium">New Report</a>
 <a href="/logout" class="text-sm bg-red-50 text-red-600 px-4 py-2 rounded-lg transition-colors border border-red-200 font-medium">Logout</a>
 </div>
 </div>

 <% if (reports.length === 0) { %>
 <div class="bg-white/80 backdrop-blur-xl border border-slate-200 rounded-2xl p-12 text-center ">
 <svg class="w-16 h-16 mx-auto text-slate-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
 <h3 class="text-lg font-medium text-slate-700">No reports found</h3>
 <p class="text-slate-500 mt-2">You haven't submitted any facility damage reports yet.</p>
 <a href="/" class="inline-block mt-6 bg-red-600 text-white font-medium py-2.5 px-6 rounded-lg transition-colors">Submit a Report</a>
 </div>
 <% } else { %>
 <div class="space-y-4">
 <% reports.forEach(function(report) { %>
 <div class="bg-white/80 backdrop-blur-xl border border-slate-200 rounded-2xl p-6 transition-">
 <div class="flex flex-col md:flex-row justify-between md:items-start gap-4">
 
 <!-- Report Details -->
 <div class="flex-1 space-y-3">
 <div class="flex items-center gap-3">
 <h3 class="font-semibold text-slate-800 text-lg"><%= report.room_location %></h3>
 <span class="text-xs font-medium px-2.5 py-1 rounded-full border 
 <%= report.urgency_level === 'critical' ? 'bg-red-50 border-red-200 text-red-600' : 
 report.urgency_level === 'high' ? 'bg-orange-50 border-orange-200 text-orange-600' : 
 'bg-slate-100 border-slate-200 text-slate-600' %>">
 <%= report.urgency_level.charAt(0).toUpperCase() + report.urgency_level.slice(1) %> Urgency
 </span>
 </div>
 
 <p class="text-slate-600 text-sm"><span class="font-medium text-slate-700">Facility:</span> <%= report.facility_type.charAt(0).toUpperCase() + report.facility_type.slice(1) %></p>
 <p class="text-slate-600 text-sm"><span class="font-medium text-slate-700">Item:</span> <%= report.item_type.charAt(0).toUpperCase() + report.item_type.slice(1) %></p>
 <p class="text-slate-600 text-sm"><span class="font-medium text-slate-700">Damage Type:</span> <%= report.damage_type.charAt(0).toUpperCase() + report.damage_type.slice(1) %></p>
 <p class="text-slate-600 text-sm bg-slate-50 p-3 rounded-lg border border-slate-100"><%= report.damage_description %></p>
 
 <p class="text-xs text-slate-400 font-medium">Submitted on <%= new Date(report.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute:'2-digit' }) %></p>
 </div>

 <!-- Status Badge & Photo -->
 <div class="flex flex-col items-end gap-3 min-w-[140px]">
 <% if (report.status === 'pending') { %>
 <div class="inline-flex items-center gap-1.5 bg-yellow-50 text-yellow-700 border border-yellow-200 px-3 py-1.5 rounded-lg text-sm font-semibold w-full justify-center">
 <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
 Pending
 </div>
 <% } else if (report.status === 'in_progress') { %>
 <div class="inline-flex items-center gap-1.5 bg-blue-50 text-blue-700 border border-blue-200 px-3 py-1.5 rounded-lg text-sm font-semibold w-full justify-center">
 <svg class="w-4 h-4 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
 In Progress
 </div>
 <% } else if (report.status === 'resolved') { %>
 <div class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-700 border border-emerald-200 px-3 py-1.5 rounded-lg text-sm font-semibold w-full justify-center">
 <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
 Resolved
 </div>
 <% } else if (report.status === 'rejected') { %>
 <div class="inline-flex items-center gap-1.5 bg-slate-100 text-slate-500 border border-slate-200 px-3 py-1.5 rounded-lg text-sm font-semibold w-full justify-center">
 <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
 Rejected
 </div>
 <% } %>
 
 <% if (report.photo_path) { %>
 <a href="<%= report.photo_path %>" target="_blank" class="block w-full overflow-hidden rounded-lg border border-slate-200 transition-colors">
 <img src="<%= report.photo_path %>" alt="Report Photo" class="w-full h-24 object-cover">
 </a>
 <% } %>
 </div>

 </div>
 </div>
 <% }); %>
 </div>
 <% } %>
 
 <div class="text-center mt-10 pb-8 text-sm text-slate-500">
 &copy; 2026 Ahnaf, Rafale, and Baruna
 </div>
 </div>

</body>
</html>
