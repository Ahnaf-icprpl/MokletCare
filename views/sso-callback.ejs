<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-6M87BW75P1"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-6M87BW75P1');
  </script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/stylesheets/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
  </style>
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col justify-center items-center p-6 relative overflow-hidden">
  
  <div class="relative z-10 text-center space-y-4">
    <div class="inline-flex items-center justify-center p-4 bg-red-100 text-red-600 rounded-full mb-2">
      <svg class="animate-spin h-8 w-8 text-red-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
    </div>
    <h2 class="text-xl font-semibold text-slate-800">Completing sign in...</h2>
    <p class="text-sm text-slate-500">Please wait while we redirect you.</p>

    <div class="pt-6 text-xs text-slate-400 space-y-2">
      <div>&copy; 2026 Ahnaf, Rafale, and Baruna &bull; MokletCare</div>
      <div class="flex items-center justify-center gap-3 text-slate-400">
        <a href="/privacy-policy" class="hover:text-slate-600 hover:underline transition-colors">Privacy Policy</a>
        <span class="text-slate-300">|</span>
        <a href="/tos" class="hover:text-slate-600 hover:underline transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>

  <script
    async
    crossorigin="anonymous"
    data-clerk-publishable-key="<%= locals.clerkPublishableKey || '' %>"
    src="https://cdn.jsdelivr.net/npm/@clerk/clerk-js@latest/dist/clerk.browser.js"
    type="text/javascript"
    onload="processCallback()"
  ></script>

  <script>
    let clerkReadyPromise = null;

    function ensureClerkReady() {
      if (window.Clerk && window.Clerk.loaded) {
        return Promise.resolve(window.Clerk);
      }
      if (clerkReadyPromise) return clerkReadyPromise;
      clerkReadyPromise = new Promise((resolve, reject) => {
        let attempts = 0;
        const maxAttempts = 150;
        const poll = async () => {
          if (window.Clerk) {
            try {
              if (!window.Clerk.loaded) {
                await window.Clerk.load();
              }
              resolve(window.Clerk);
            } catch (err) {
              clerkReadyPromise = null;
              reject(err);
            }
          } else {
            attempts++;
            if (attempts >= maxAttempts) {
              clerkReadyPromise = null;
              reject(new Error('Authentication service timeout. Please try again.'));
            } else {
              setTimeout(poll, 100);
            }
          }
        };
        poll();
      });
      return clerkReadyPromise;
    }

    let callbackHandled = false;
    async function processCallback() {
      if (callbackHandled) return;
      callbackHandled = true;
      try {
        const clerk = await ensureClerkReady();
        await clerk.handleRedirectCallback({});
        if (clerk.session) {
          const token = await clerk.session.getToken();
          if (token) {
            document.cookie = `__session=${token}; path=/; max-age=86400; SameSite=Lax`;
          }
        }
        window.location.replace('/report');
      } catch (err) {
        console.error('SSO callback error:', err);
        window.location.replace('/login?error=' + encodeURIComponent('Authentication failed. Please try again.'));
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', processCallback);
    } else {
      processCallback();
    }
  </script>
</body>
</html>
