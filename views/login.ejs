<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title><%= title %></title>
 <link rel="stylesheet" href="/stylesheets/style.css">
 <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
 <style>
 body { font-family: 'Inter', sans-serif; }
 </style>
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col justify-center items-center p-6 relative overflow-hidden">
 
 <!-- Background Image -->
 <div class="fixed inset-0 z-0 pointer-events-none overflow-hidden">
 <div class="absolute inset-0 bg-[url('/images/telkomschools.jpg')] bg-cover bg-center bg-no-repeat blur-xl scale-110 opacity-40"></div>
 <div class="absolute inset-0 bg-slate-50/80"></div>
 </div>

 <div class="relative z-10 w-full max-w-md">
 <div class="text-center mb-10">
 <h1 class="text-4xl font-extrabold text-red-600 mb-4 tracking-tight">SMK Telkom Malang</h1>
 <p class="text-slate-600 text-lg font-light">Facility Damage Reporting Portal</p>
 </div>

 <!-- Login Card -->
 <div class="bg-white/80 backdrop-blur-xl border border-red-100 rounded-2xl p-8 text-center">
 <h2 class="text-2xl font-semibold mb-6 text-slate-800">Sign In Required</h2>
 <p class="text-slate-500 mb-8 text-sm">Please log in using your official school Google account to access the reporting portal.</p>
 
 <a href="/auth/google" class="inline-flex items-center justify-center w-full bg-white text-slate-700 border border-slate-200 font-semibold py-3.5 px-6 rounded-lg transform transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-slate-50 focus:ring-red-500">
 <svg class="w-5 h-5 mr-3" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
 Sign in with Google
 </a>
 </div>
 
 <div class="text-center mt-8 text-sm text-slate-500">
 &copy; 2026 Ahnaf, Rafale, and Baruna
 </div>
 </div>
</body>
</html>
