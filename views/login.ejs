<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/stylesheets/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
  </style>
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col justify-center items-center p-6 relative overflow-x-hidden">
  
  <!-- Background Image -->
  <div class="fixed inset-0 z-0 pointer-events-none overflow-hidden">
    <div class="absolute inset-0 bg-[url('/images/telkomschools.jpg')] bg-cover bg-center bg-no-repeat blur-xl scale-110 opacity-40"></div>
    <div class="absolute inset-0 bg-slate-50/80"></div>
  </div>

  <div class="relative z-10 w-full max-w-md my-8">
    <div class="text-center mb-8">
      <h1 class="text-4xl font-extrabold text-red-600 mb-3 tracking-tight">MokletCare</h1>
      <p class="text-slate-600 text-lg font-light">Facility Damage Reporting Portal</p>
    </div>

    <!-- Main Auth Card -->
    <div class="bg-white/80 backdrop-blur-xl border border-red-100 rounded-2xl p-8 shadow-xl">
      
      <h2 class="text-xl font-semibold text-slate-800 text-center mb-2">Welcome</h2>
      <p class="text-sm text-slate-500 text-center mb-8">Sign in with your account to continue</p>

      <!-- Error Notification Alert -->
      <div id="error-alert" class="hidden mb-6 bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3 rounded-xl flex items-start gap-3">
        <svg class="w-5 h-5 text-red-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span id="error-alert-text">An error occurred</span>
      </div>

      <!-- SSO Buttons -->
      <div class="space-y-3">
        <button type="button" id="google-btn" onclick="loginWithOAuth('oauth_google')" class="w-full bg-white hover:bg-slate-50 text-slate-700 font-semibold py-3 px-4 rounded-lg border border-slate-200 shadow-sm flex items-center justify-center gap-3 transition-colors focus:outline-none focus:ring-2 focus:ring-red-500 disabled:opacity-60 disabled:cursor-not-allowed">
          <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          <span>Continue with Google</span>
        </button>

        <button type="button" id="apple-btn" onclick="loginWithOAuth('oauth_apple')" class="w-full bg-black hover:bg-slate-900 text-white font-semibold py-3 px-4 rounded-lg shadow-sm flex items-center justify-center gap-3 transition-colors focus:outline-none focus:ring-2 focus:ring-slate-500 disabled:opacity-60 disabled:cursor-not-allowed">
          <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.84c.66-.8 1.11-1.92.99-3.04-1 .04-2.2.67-2.91 1.5-.64.74-1.2 1.9-1.05 3.01 1.12.09 2.31-.67 2.97-1.47z"/>
          </svg>
          <span>Continue with Apple</span>
        </button>
      </div>

    </div>

    <div class="text-center mt-8 text-xs text-slate-500 space-y-2">
      <div>&copy; 2026 Ahnaf, Rafale, and Baruna &bull; MokletCare</div>
      <div class="flex items-center justify-center gap-3 text-slate-500">
        <a href="/privacy-policy" class="hover:text-slate-800 hover:underline transition-colors">Privacy Policy</a>
        <span class="text-slate-300">|</span>
        <a href="/tos" class="hover:text-slate-800 hover:underline transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>

  <script
    async
    crossorigin="anonymous"
    data-clerk-publishable-key="<%= clerkPublishableKey %>"
    src="https://cdn.jsdelivr.net/npm/@clerk/clerk-js@latest/dist/clerk.browser.js"
    type="text/javascript"
  ></script>

  <script>
    function showError(msg) {
      const alert = document.getElementById('error-alert');
      const alertText = document.getElementById('error-alert-text');
      alertText.textContent = msg;
      alert.classList.remove('hidden');
    }

    function hideError() {
      document.getElementById('error-alert').classList.add('hidden');
    }

    async function loginWithOAuth(strategy) {
      hideError();
      if (!window.Clerk) {
        showError('Authentication service is loading. Please try again in a moment.');
        return;
      }

      // Disable buttons while redirecting
      document.getElementById('google-btn').disabled = true;
      document.getElementById('apple-btn').disabled = true;

      try {
        if (window.Clerk.session) {
          const token = await window.Clerk.session.getToken();
          if (token) {
            document.cookie = `__session=${token}; path=/; max-age=86400; SameSite=Lax`;
            window.location.replace('/');
            return;
          }
        }
        await window.Clerk.client.signIn.authenticateWithRedirect({
          strategy: strategy,
          redirectUrl: '/sso-callback',
          redirectUrlComplete: '/'
        });
      } catch (err) {
        console.error('OAuth error:', err);
        if (err.errors && err.errors[0] && err.errors[0].code === 'session_exists') {
          try {
            const token = await window.Clerk.session?.getToken();
            if (token) {
              document.cookie = `__session=${token}; path=/; max-age=86400; SameSite=Lax`;
              window.location.replace('/');
              return;
            }
          } catch(retryErr) {
            console.error('Retry token sync error:', retryErr);
          }
        }
        const errorMsg = (err.errors && err.errors[0]) 
          ? (err.errors[0].longMessage || err.errors[0].message) 
          : 'Sign in failed. Please try again.';
        showError(errorMsg);
        document.getElementById('google-btn').disabled = false;
        document.getElementById('apple-btn').disabled = false;
      }
    }

    window.addEventListener('load', async () => {
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.has('error')) {
        showError(urlParams.get('error'));
      }
      if (!window.Clerk) return;
      try {
        await window.Clerk.load();
        if (window.Clerk.session) {
          try {
            const token = await window.Clerk.session.getToken();
            if (token) {
              document.cookie = `__session=${token}; path=/; max-age=86400; SameSite=Lax`;
              window.location.replace('/');
              return;
            }
          } catch (e) {
            console.error('Session sync error:', e);
          }
        }
      } catch (err) {
        console.error('Error loading Clerk JS:', err);
      }
    });
  </script>
</body>
</html>
