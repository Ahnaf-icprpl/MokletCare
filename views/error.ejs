<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Error | MokletCare</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
  </style>
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col justify-center items-center p-6 relative overflow-hidden">
  
  <!-- Background Image -->
  <div class="fixed inset-0 z-0 pointer-events-none overflow-hidden">
    <div class="absolute inset-0 bg-[url('/images/telkomschools.jpg')] bg-cover bg-center bg-no-repeat blur-xl scale-110 opacity-40"></div>
    <div class="absolute inset-0 bg-slate-50/80"></div>
  </div>

  <div class="relative z-10 w-full max-w-lg text-center">
    <div class="bg-white/80 backdrop-blur-xl border border-red-100 rounded-2xl p-8 md:p-12 shadow-xl space-y-6">
      
      <div class="w-16 h-16 bg-red-100 text-red-600 rounded-full flex items-center justify-center mx-auto">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
      </div>

      <div>
        <h1 class="text-2xl font-bold text-slate-800 mb-2"><%= locals.message || 'An Error Occurred' %></h1>
        <p class="text-sm text-slate-500"><%= locals.error && error.status ? 'Error Code: ' + error.status : 'Something went wrong while processing your request.' %></p>
      </div>

      <% if (locals.error && error.stack) { %>
      <div class="bg-slate-900 text-slate-200 text-left text-xs p-4 rounded-xl font-mono overflow-x-auto max-h-48">
        <%= error.stack %>
      </div>
      <% } %>

      <div class="pt-2">
        <a href="/" class="inline-flex items-center gap-2 bg-red-600 hover:bg-red-700 text-white font-semibold py-3 px-6 rounded-lg transition duration-200">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
          <span>Return to Dashboard</span>
        </a>
      </div>

    </div>

    <div class="mt-8 text-sm text-slate-500">
      &copy; 2026 Ahnaf, Rafale, and Baruna
    </div>
  </div>
</body>
</html>
