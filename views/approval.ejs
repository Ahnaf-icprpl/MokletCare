<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Approval Page | MokletCare Admin</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: #f8fafc; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
  </style>
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col justify-between items-center p-4 md:p-8 relative overflow-x-hidden">
  
  <!-- Background Image with Overlay -->
  <div class="fixed inset-0 z-0 pointer-events-none overflow-hidden">
    <div class="absolute inset-0 bg-[url('/images/telkomschools.jpg')] bg-cover bg-center bg-no-repeat blur-xl scale-110 opacity-30"></div>
    <div class="absolute inset-0 bg-slate-50/85"></div>
  </div>

  <div class="relative z-10 w-full max-w-6xl">
    
    <!-- Top Navigation Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4 bg-white/80 backdrop-blur-xl border border-red-100 rounded-2xl p-6 shadow-sm">
      <div>
        <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Approval Page</h1>
        <p class="text-xs text-slate-500">Logged in as <strong class="text-slate-800"><%= locals.user ? user.displayName : 'Admin' %></strong> (<span class="capitalize font-semibold text-red-600">Admin</span>)</p>
      </div>

      <div class="flex items-center gap-2 sm:gap-3 w-full sm:w-auto">
        <a href="/logout" class="text-xs bg-red-50 text-red-600 hover:bg-red-100 px-4 py-2 rounded-lg transition-colors border border-red-200 font-semibold text-center">
          Logout
        </a>
      </div>
    </div>

    <!-- Alert Notifications -->
    <% if (locals.error) { %>
    <div class="mb-6 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl flex items-center gap-3">
      <svg class="w-5 h-5 text-red-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      <span class="font-medium text-sm"><%= error %></span>
    </div>
    <% } %>

    <% if (locals.success) { %>
    <div class="mb-6 bg-emerald-50 border border-emerald-200 text-emerald-700 px-4 py-3 rounded-xl flex items-center gap-3">
      <svg class="w-5 h-5 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
      <span class="font-medium text-sm"><%= success %></span>
    </div>
    <% } %>

    <!-- Charts Section -->
    <div class="bg-white/80 backdrop-blur-xl border border-slate-200 rounded-2xl shadow-xl p-6 md:p-8 mb-8">
      <div class="flex flex-col lg:flex-row justify-between items-start gap-8">
        <div class="flex-1">
          <h2 class="text-xl font-bold text-slate-900 mb-6">Approval Request Status Distribution</h2>
          <div class="flex items-center justify-center">
            <canvas id="requestStatusChart" class="max-w-sm"></canvas>
          </div>
        </div>

        <!-- Legend -->
        <div class="flex-1 space-y-4" data-pending="<%= requestStats.pending %>" data-approved="<%= requestStats.approved %>" data-rejected="<%= requestStats.rejected %>">
          <h3 class="text-lg font-semibold text-slate-900 mb-4">Request Breakdown</h3>
          <div class="space-y-3">
            <div class="flex items-center gap-3 p-3 rounded-lg bg-amber-50 border border-amber-100">
              <div class="w-4 h-4 rounded-full bg-amber-400"></div>
              <div>
                <div class="text-sm font-semibold text-slate-900">Pending</div>
                <div class="text-xs text-slate-600"><%= requestStats.pending %> requests</div>
              </div>
            </div>
            <div class="flex items-center gap-3 p-3 rounded-lg bg-emerald-50 border border-emerald-100">
              <div class="w-4 h-4 rounded-full bg-emerald-400"></div>
              <div>
                <div class="text-sm font-semibold text-slate-900">Approved</div>
                <div class="text-xs text-slate-600"><%= requestStats.approved %> requests</div>
              </div>
            </div>
            <div class="flex items-center gap-3 p-3 rounded-lg bg-red-50 border border-red-100">
              <div class="w-4 h-4 rounded-full bg-red-400"></div>
              <div>
                <div class="text-sm font-semibold text-slate-900">Rejected</div>
                <div class="text-xs text-slate-600"><%= requestStats.rejected %> requests</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Approval Requests Section -->
    <div class="bg-white/80 backdrop-blur-xl border border-slate-200 rounded-2xl shadow-xl p-6 md:p-8 mb-8">
      <div class="mb-6">
        <h2 class="text-xl font-bold text-slate-900 mb-2">Staff Photo Approval Requests</h2>
        <p class="text-xs text-slate-500">Review and approve or reject photo requests submitted by staff</p>
      </div>

      <!-- Filter Tabs -->
      <div class="flex items-center gap-1.5 overflow-x-auto pb-3 border-b border-slate-100 mb-6">
        <% const statuses = [
          { key: 'all', label: 'All' },
          { key: 'pending', label: 'Pending' },
          { key: 'approved', label: 'Approved' },
          { key: 'rejected', label: 'Rejected' }
        ]; %>
        <% statuses.forEach(function(s) { %>
          <% const isActive = requestPagination.status === s.key || (s.key === 'all' && !requestPagination.status); %>
          <a href="/admin/approval?status=<%= s.key %>" class="px-3 py-1.5 rounded-lg text-xs transition-colors whitespace-nowrap <%= isActive ? 'font-semibold bg-red-600 text-white shadow-sm' : 'font-medium bg-slate-100 text-slate-600 hover:bg-slate-200' %>">
            <%= s.label %>
          </a>
        <% }); %>
      </div>

      <% if (requests.length === 0) { %>
      <div class="text-center py-12 text-slate-400">
        <svg class="w-12 h-12 text-slate-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <p class="font-medium text-slate-600">No approval requests found</p>
        <p class="text-xs text-slate-400 mt-1">All requests have been processed or none are pending.</p>
      </div>
      <% } else { %>
      <div class="space-y-4">
        <% requests.forEach(function(req) { %>
        <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 md:p-6">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-4">
            <!-- Photo Preview -->
            <div class="md:col-span-1">
              <a href="<%= req.photo_url %>" target="_blank" rel="noopener noreferrer" class="block group relative overflow-hidden rounded-lg">
                <img src="<%= req.photo_url %>" alt="Photo" class="w-full h-44 object-cover rounded-lg border border-slate-200 shadow-sm group-hover:opacity-90 transition-opacity">
                <span class="absolute bottom-2 right-2 bg-slate-900/80 text-white text-[10px] px-2 py-0.5 rounded font-medium backdrop-blur-sm">Click to Expand</span>
              </a>
            </div>

            <!-- Request Details -->
            <div class="md:col-span-2 space-y-3">
              <div class="flex items-start justify-between">
                <div>
                  <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">From Staff</div>
                  <div class="text-sm font-bold text-slate-900"><%= req.staff_name %></div>
                  <div class="text-xs text-slate-500"><%= req.staff_email %></div>
                </div>
                <% if (req.status === 'pending') { %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-700 whitespace-nowrap">Pending</span>
                <% } else if (req.status === 'approved') { %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-700 whitespace-nowrap">Approved</span>
                <% } else { %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-700 whitespace-nowrap">Rejected</span>
                <% } %>
              </div>

              <div>
                <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Report #<%= req.report_id %></div>
                <div class="text-sm text-slate-700"><%= req.photo_description || 'No description provided' %></div>
              </div>

              <div>
                <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Target Recipient (<%= req.recipient_type === 'admin' ? 'Admin' : 'Reporter' %>)</div>
                <div class="text-sm text-slate-600"><%= req.recipient_email %></div>
              </div>

              <% if (req.request_message) { %>
              <div class="bg-white p-3 rounded-lg border border-slate-200">
                <div class="text-xs font-semibold text-slate-400 mb-1 uppercase tracking-wider">Staff Message</div>
                <div class="text-sm text-slate-700"><%= req.request_message %></div>
              </div>
              <% } %>

              <!-- Action Buttons (only for pending requests) -->
              <% if (req.status === 'pending') { %>
              <div class="flex gap-2 pt-2">
                <form action="/admin/approval/<%= req.id %>/approve" method="POST" class="flex-1">
                  <button type="submit" class="w-full text-xs bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-3 py-2.5 rounded-lg transition-colors shadow-sm cursor-pointer">
                    Approve Request
                  </button>
                </form>
                <form action="/admin/approval/<%= req.id %>/reject" method="POST" class="flex-1">
                  <button type="submit" class="w-full text-xs bg-red-600 hover:bg-red-700 text-white font-bold px-3 py-2.5 rounded-lg transition-colors shadow-sm cursor-pointer">
                    Reject Request
                  </button>
                </form>
              </div>
              <% } %>
            </div>
          </div>

          <div class="text-xs text-slate-400 pt-3 border-t border-slate-200">
            Submitted on <%= new Date(req.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
          </div>
        </div>
        <% }); %>
      </div>

      <!-- Pagination -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mt-6 pt-6 border-t border-slate-200 text-xs text-slate-500">
        <div>
          Showing <strong class="text-slate-800"><%= Math.min((requestPagination.page - 1) * requestPagination.limit + 1, requestPagination.totalItems) %></strong>
          to <strong class="text-slate-800"><%= Math.min(requestPagination.page * requestPagination.limit, requestPagination.totalItems) %></strong>
          of <strong class="text-slate-800"><%= requestPagination.totalItems %></strong> requests
        </div>

        <div class="flex items-center gap-1">
          <% 
            const prevPage = requestPagination.page > 1 ? requestPagination.page - 1 : 1;
            const nextPage = requestPagination.page < requestPagination.totalPages ? requestPagination.page + 1 : requestPagination.totalPages;
          %>
          <a href="/admin/approval?status=<%= requestPagination.status %>&page=<%= prevPage %>" class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 font-medium text-slate-600 transition-colors <%= requestPagination.page <= 1 ? 'pointer-events-none opacity-50' : '' %>">
            Previous
          </a>
          <span class="px-3 py-1.5 font-semibold text-slate-700">
            Page <%= requestPagination.page %> of <%= requestPagination.totalPages %>
          </span>
          <a href="/admin/approval?status=<%= requestPagination.status %>&page=<%= nextPage %>" class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 font-medium text-slate-600 transition-colors <%= requestPagination.page >= requestPagination.totalPages ? 'pointer-events-none opacity-50' : '' %>">
            Next
          </a>
        </div>
      </div>
      <% } %>
    </div>

    <div class="text-center text-xs text-slate-400 pb-8 space-y-2">
      <div>&copy; 2026 Ahnaf, Rafale, and Baruna &bull; MokletCare</div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0/dist/chartjs-plugin-datalabels.min.js"></script>
  <script>
    window.addEventListener('load', async () => {
      // Register Chart.js plugins
      Chart.register(ChartDataLabels);

      // Initialize Status Chart
      const ctx = document.getElementById('requestStatusChart');
      if (ctx) {
        const statsEl = document.querySelector('[data-pending]');
        const chartData = [
          parseInt(statsEl.dataset.pending),
          parseInt(statsEl.dataset.approved),
          parseInt(statsEl.dataset.rejected)
        ];
        new Chart(ctx, {
          type: 'pie',
          data: {
            labels: ['Pending', 'Approved', 'Rejected'],
            datasets: [
              {
                label: 'Requests',
                data: chartData,
                backgroundColor: [
                  '#FBBF24',
                  '#22C55E',
                  '#EF4444'
                ],
                borderColor: [
                  '#F59E0B',
                  '#16A34A',
                  '#DC2626'
                ],
                borderWidth: 2
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: true,
            plugins: {
              legend: {
                display: true,
                position: 'right',
                labels: {
                  font: {
                    size: 12,
                    weight: '500'
                  },
                  padding: 15,
                  usePointStyle: true,
                  pointStyle: 'circle'
                }
              },
              tooltip: {
                callbacks: {
                  label: function(context) {
                    const label = context.label || '';
                    const value = context.parsed;
                    const total = context.dataset.data.reduce((a, b) => a + b, 0);
                    const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
                    return label + ': ' + value + ' (' + percentage + '%)';
                  }
                }
              },
              datalabels: {
                formatter: (value, ctx) => {
                  const sum = ctx.dataset.data.reduce((a, b) => a + b, 0);
                  if (sum === 0) return '0%';
                  const percentage = (value * 100 / sum).toFixed(1) + '%';
                  return percentage;
                },
                color: '#fff',
                font: {
                  weight: 'bold',
                  size: 14
                }
              }
            }
          }
        });
      }
    });
  </script>
</body>
</html>
