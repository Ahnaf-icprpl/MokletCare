<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard | MokletCare</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: #f8fafc; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
  </style>
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col justify-between items-center p-4 md:p-8 relative overflow-x-hidden">
  
  <!-- Background Image with Overlay -->
  <div class="fixed inset-0 z-0 pointer-events-none overflow-hidden">
    <div class="absolute inset-0 bg-[url('/images/telkomschools.jpg')] bg-cover bg-center bg-no-repeat blur-xl scale-110 opacity-30"></div>
    <div class="absolute inset-0 bg-slate-50/85"></div>
  </div>

  <div class="relative z-10 w-full max-w-6xl">
    
    <!-- Top Navigation Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4 bg-white/80 backdrop-blur-xl border border-red-100 rounded-2xl p-6 shadow-sm">
      <div>
        <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">MokletCare Dashboard</h1>
        <p class="text-xs text-slate-500">Logged in as <strong class="text-slate-800"><%= user.displayName %></strong> (<span class="capitalize font-semibold text-red-600"><%= user.role %></span>)</p>
      </div>

      <div class="flex items-center gap-2 sm:gap-3 w-full sm:w-auto">
        <a href="/" class="text-xs bg-white text-slate-600 hover:bg-slate-50 px-3.5 py-2 rounded-lg transition-colors border border-slate-200 font-medium text-center">
          Report Portal
        </a>
        <a href="/history" class="text-xs bg-white text-slate-600 hover:bg-slate-50 px-3.5 py-2 rounded-lg transition-colors border border-slate-200 font-medium text-center">
          My Reports
        </a>
        <a href="/logout" class="text-xs bg-red-50 text-red-600 hover:bg-red-100 px-3.5 py-2 rounded-lg transition-colors border border-red-200 font-medium text-center">
          Logout
        </a>
      </div>
    </div>

    <!-- Alert Notifications -->
    <% if (locals.error) { %>
    <div class="mb-6 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl flex items-center gap-3">
      <svg class="w-5 h-5 text-red-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      <span class="font-medium text-sm"><%= error %></span>
    </div>
    <% } %>

    <% if (locals.success) { %>
    <div class="mb-6 bg-emerald-50 border border-emerald-200 text-emerald-700 px-4 py-3 rounded-xl flex items-center gap-3">
      <svg class="w-5 h-5 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
      <span class="font-medium text-sm"><%= success %></span>
    </div>
    <% } %>

    <!-- Statistics Overview Cards -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-8">
      <div class="bg-white/80 backdrop-blur-xl border border-slate-200 rounded-2xl p-5 shadow-sm">
        <div class="text-xs font-medium text-slate-500 uppercase tracking-wider mb-1">Total Reports</div>
        <div class="text-3xl font-extrabold text-slate-900"><%= stats.total %></div>
      </div>
      <div class="bg-white/80 backdrop-blur-xl border border-amber-200 rounded-2xl p-5 shadow-sm">
        <div class="text-xs font-medium text-amber-600 uppercase tracking-wider mb-1">Pending</div>
        <div class="text-3xl font-extrabold text-amber-600"><%= stats.pending %></div>
      </div>
      <div class="bg-white/80 backdrop-blur-xl border border-blue-200 rounded-2xl p-5 shadow-sm">
        <div class="text-xs font-medium text-blue-600 uppercase tracking-wider mb-1">In Progress</div>
        <div class="text-3xl font-extrabold text-blue-600"><%= stats.in_progress %></div>
      </div>
      <div class="bg-white/80 backdrop-blur-xl border border-emerald-200 rounded-2xl p-5 shadow-sm">
        <div class="text-xs font-medium text-emerald-600 uppercase tracking-wider mb-1">Resolved</div>
        <div class="text-3xl font-extrabold text-emerald-600"><%= stats.resolved %></div>
      </div>
      <div class="bg-white/80 backdrop-blur-xl border border-slate-200 rounded-2xl p-5 shadow-sm col-span-2 md:col-span-1">
        <div class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-1">Rejected</div>
        <div class="text-3xl font-extrabold text-slate-500"><%= stats.rejected %></div>
      </div>
    </div>

    <!-- Charts Section -->
    <div class="bg-white/80 backdrop-blur-xl border border-slate-200 rounded-2xl shadow-xl p-6 md:p-8 mb-8">
      <div class="flex flex-col lg:flex-row justify-between items-start gap-8">
        <div class="flex-1">
          <h2 class="text-xl font-bold text-slate-900 mb-6">Report Status Distribution</h2>
          <div class="flex items-center justify-center">
            <canvas id="statusChart" class="max-w-sm"></canvas>
          </div>
        </div>

        <!-- Legend -->
        <div class="flex-1 space-y-4" data-stats-pending="<%= stats.pending %>" data-stats-in-progress="<%= stats.in_progress %>" data-stats-resolved="<%= stats.resolved %>" data-stats-rejected="<%= stats.rejected %>">
          <h3 class="text-lg font-semibold text-slate-900 mb-4">Status Breakdown</h3>
          <div class="space-y-3">
            <div class="flex items-center gap-3 p-3 rounded-lg bg-amber-50 border border-amber-100">
              <div class="w-4 h-4 rounded-full bg-amber-400"></div>
              <div>
                <div class="text-sm font-semibold text-slate-900">Pending</div>
                <div class="text-xs text-slate-600"><%= stats.pending %> reports</div>
              </div>
            </div>
            <div class="flex items-center gap-3 p-3 rounded-lg bg-blue-50 border border-blue-100">
              <div class="w-4 h-4 rounded-full bg-blue-400"></div>
              <div>
                <div class="text-sm font-semibold text-slate-900">In Progress</div>
                <div class="text-xs text-slate-600"><%= stats.in_progress %> reports</div>
              </div>
            </div>
            <div class="flex items-center gap-3 p-3 rounded-lg bg-emerald-50 border border-emerald-100">
              <div class="w-4 h-4 rounded-full bg-emerald-400"></div>
              <div>
                <div class="text-sm font-semibold text-slate-900">Resolved</div>
                <div class="text-xs text-slate-600"><%= stats.resolved %> reports</div>
              </div>
            </div>
            <div class="flex items-center gap-3 p-3 rounded-lg bg-slate-50 border border-slate-100">
              <div class="w-4 h-4 rounded-full bg-slate-400"></div>
              <div>
                <div class="text-sm font-semibold text-slate-900">Rejected</div>
                <div class="text-xs text-slate-600"><%= stats.rejected %> reports</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Reports Section -->
    <div class="bg-white/80 backdrop-blur-xl border border-slate-200 rounded-2xl shadow-xl p-6 md:p-8 mb-8">
      
      <!-- Section Header + Controls -->
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-6">
        <div>
          <h2 class="text-xl font-bold text-slate-900">Facility Damage Reports</h2>
          <p class="text-xs text-slate-500 mt-0.5">Click any report row to view full details and update status</p>
        </div>

        <!-- Fuzzy Search & Filter Controls -->
        <form action="/dashboard" method="GET" class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
          <input type="hidden" name="status" value="<%= reportPagination.status %>">
          <% if (locals.userPagination && userPagination.q) { %>
            <input type="hidden" name="user_q" value="<%= userPagination.q %>">
          <% } %>

          <div class="relative flex-1 sm:w-64">
            <input type="text" name="q" value="<%= reportPagination.q %>" placeholder="Search room, item, reporter..." class="w-full bg-white border border-slate-200 rounded-lg pl-9 pr-4 py-2 text-xs text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-red-500 transition duration-200">
            <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
          </div>

          <button type="submit" class="text-xs bg-slate-900 hover:bg-slate-800 text-white font-medium px-4 py-2 rounded-lg transition-colors">
            Search
          </button>
          
          <% if (reportPagination.q) { %>
            <a href="/dashboard?status=<%= reportPagination.status %>" class="text-xs bg-slate-100 hover:bg-slate-200 text-slate-600 font-medium px-3 py-2 rounded-lg transition-colors text-center">Clear</a>
          <% } %>
        </form>
      </div>

      <!-- Status Filter Tabs -->
      <div class="flex items-center gap-1.5 overflow-x-auto pb-3 border-b border-slate-100 mb-6">
        <% const statuses = [
          { key: 'all', label: 'All' },
          { key: 'unresolved', label: 'All (except resolved)' },
          { key: 'pending', label: 'Pending' },
          { key: 'in_progress', label: 'In Progress' },
          { key: 'resolved', label: 'Resolved' },
          { key: 'rejected', label: 'Rejected' }
        ]; %>
        <% statuses.forEach(function(s) { %>
          <% 
            let queryStr = `?status=${s.key}&q=${encodeURIComponent(reportPagination.q)}`;
            if (locals.userPagination && userPagination.q) queryStr += `&user_q=${encodeURIComponent(userPagination.q)}`;
            const isActive = reportPagination.status === s.key || (s.key === 'unresolved' && (!reportPagination.status || reportPagination.status === 'unresolved'));
          %>
          <a href="/dashboard<%= queryStr %>" class="px-3 py-1.5 rounded-lg text-xs transition-colors whitespace-nowrap <%= isActive ? 'font-semibold bg-red-600 text-white shadow-sm' : 'font-medium bg-slate-100 text-slate-600 hover:bg-slate-200' %>">
            <%= s.label %>
          </a>
        <% }); %>
      </div>

      <% if (reports.length === 0) { %>
      <div class="text-center py-12 text-slate-400">
        <svg class="w-12 h-12 text-slate-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <p class="font-medium text-slate-600">No damage reports found</p>
        <p class="text-xs text-slate-400 mt-1"><%= reportPagination.q ? 'Try adjusting your search query or status filter.' : 'No reports in this category yet.' %></p>
      </div>
      <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b border-slate-200 text-slate-500 font-medium text-xs uppercase tracking-wider">
              <th class="py-3.5 px-4">Photo</th>
              <th class="py-3.5 px-4">Reporter</th>
              <th class="py-3.5 px-4">Facility & Item</th>
              <th class="py-3.5 px-4">Location</th>
              <th class="py-3.5 px-4">Urgency</th>
              <th class="py-3.5 px-4">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% reports.forEach(function(report) { %>
            <%
              const itemLabel = formatOptionText(report.item_type, locals.optionMap);
              const facilityLabel = formatOptionText(report.facility_type, locals.optionMap);
              const damageLabel = formatOptionText(report.damage_type, locals.optionMap);
              const urgencyLabel = formatOptionText(report.urgency_level, locals.optionMap);
            %>
            <tr class="hover:bg-slate-100/70 transition-colors cursor-pointer group"
                onclick="openReportModal(this)"
                data-id="<%= report.id %>"
                data-reporter-name="<%= report.reporter_name %>"
                data-reporter-email="<%= report.reporter_email %>"
                data-facility-label="<%= facilityLabel %>"
                data-item-label="<%= itemLabel %>"
                data-damage-label="<%= damageLabel %>"
                data-room-location="<%= report.room_location %>"
                data-urgency-level="<%= report.urgency_level %>"
                data-urgency-label="<%= urgencyLabel %>"
                data-description="<%= (report.damage_description || '').replace(/"/g, '&quot;') %>"
                data-photo-path="<%= report.photo_path %>"
                data-finished-photo-path="<%= report.finished_photo_path || '' %>"
                data-admin-reply="<%= (report.admin_reply || '').replace(/"/g, '&quot;') %>"
                data-resolved-at="<%= report.resolved_at || '' %>"
                data-status="<%= report.status %>"
                data-created-at="<%= report.created_at %>"
                data-is-approved="<%= report.is_approved ? 'true' : 'false' %>"
                data-has-pending-approval="<%= report.has_pending_approval ? 'true' : 'false' %>">
              <td class="py-4 px-4" onclick="event.stopPropagation()">
                <div class="flex items-center gap-1.5">
                  <a href="<%= report.photo_path %>" target="_blank" rel="noopener noreferrer" title="Damage Photo">
                    <img src="<%= report.photo_path %>" alt="Damage Photo" class="w-12 h-12 rounded-lg object-cover border border-slate-200 hover:opacity-90 transition-opacity">
                  </a>
                  <% if (report.finished_photo_path) { %>
                  <a href="<%= report.finished_photo_path %>" target="_blank" rel="noopener noreferrer" title="Finished Photo (Proof of Repair)">
                    <div class="relative">
                      <img src="<%= report.finished_photo_path %>" alt="Finished Photo" class="w-12 h-12 rounded-lg object-cover border-2 border-emerald-500 shadow-sm hover:opacity-90 transition-opacity">
                      <span class="absolute -top-1 -right-1 bg-emerald-500 text-white rounded-full p-0.5 shadow-sm">
                        <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                      </span>
                    </div>
                  </a>
                  <% } %>
                </div>
              </td>
              <td class="py-4 px-4">
                <div class="font-medium text-slate-900 group-hover:text-red-600 transition-colors"><%= report.reporter_name %></div>
                <div class="text-xs text-slate-400 truncate max-w-[140px]" title="<%= report.reporter_email %>"><%= report.reporter_email %></div>
              </td>
              <td class="py-4 px-4">
                <div class="font-semibold text-slate-800"><%= itemLabel %></div>
                <div class="text-xs text-slate-500"><%= facilityLabel %> &bull; <%= damageLabel %></div>
              </td>
              <td class="py-4 px-4 text-slate-700 font-medium">
                <%= report.room_location %>
              </td>
              <td class="py-4 px-4">
                <div class="space-y-1">
                  <% const isHighUrgency = isHighOrAboveUrgency(report.urgency_level); %>
                  <% if (isHighUrgency) { %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-700 whitespace-nowrap"><%= urgencyLabel %></span>
                    <div class="text-[10px] font-bold text-emerald-700 flex items-center gap-0.5">⚡ Direct Proceed</div>
                  <% } else if (report.urgency_level === 'medium' || report.urgency_level === 'Sedang') { %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-700 whitespace-nowrap"><%= urgencyLabel %></span>
                    <% if (report.is_approved) { %>
                      <div class="text-[10px] font-bold text-emerald-700 flex items-center gap-0.5">✓ Admin Approved</div>
                    <% } else if (report.has_pending_approval) { %>
                      <div class="text-[10px] font-bold text-amber-600 flex items-center gap-0.5">⏳ Approval Pending</div>
                    <% } else { %>
                      <div class="text-[10px] font-medium text-slate-400">Needs Approval</div>
                    <% } %>
                  <% } else { %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-700 whitespace-nowrap"><%= urgencyLabel %></span>
                    <% if (report.is_approved) { %>
                      <div class="text-[10px] font-bold text-emerald-700 flex items-center gap-0.5">✓ Admin Approved</div>
                    <% } else if (report.has_pending_approval) { %>
                      <div class="text-[10px] font-bold text-amber-600 flex items-center gap-0.5">⏳ Approval Pending</div>
                    <% } else { %>
                      <div class="text-[10px] font-medium text-slate-400">Needs Approval</div>
                    <% } %>
                  <% } %>
                </div>
              </td>
              <td class="py-4 px-4">
                <% if (report.status === 'pending') { %>
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-600 border border-amber-200 whitespace-nowrap">Pending</span>
                <% } else if (report.status === 'in_progress') { %>
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-600 border border-blue-200 whitespace-nowrap">In Progress</span>
                <% } else if (report.status === 'resolved') { %>
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-600 border border-emerald-200 whitespace-nowrap">Resolved</span>
                <% } else { %>
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-600 border border-slate-200 whitespace-nowrap">Rejected</span>
                <% } %>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <!-- SQL Database Pagination Bar for Reports -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mt-6 pt-6 border-t border-slate-200 text-xs text-slate-500">
        <div>
          Showing <strong class="text-slate-800"><%= Math.min((reportPagination.page - 1) * reportPagination.limit + 1, reportPagination.totalItems) %></strong>
          to <strong class="text-slate-800"><%= Math.min(reportPagination.page * reportPagination.limit, reportPagination.totalItems) %></strong>
          of <strong class="text-slate-800"><%= reportPagination.totalItems %></strong> matching reports
        </div>

        <div class="flex items-center gap-1">
          <% 
            const prevPage = reportPagination.page > 1 ? reportPagination.page - 1 : 1;
            const nextPage = reportPagination.page < reportPagination.totalPages ? reportPagination.page + 1 : reportPagination.totalPages;
            const baseReportUrl = `/dashboard?status=${reportPagination.status}&q=${encodeURIComponent(reportPagination.q)}${locals.userPagination && userPagination.q ? '&user_q=' + encodeURIComponent(userPagination.q) : ''}`;
          %>

          <a href="<%= baseReportUrl %>&page=<%= prevPage %>" class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 font-medium text-slate-600 transition-colors <%= reportPagination.page <= 1 ? 'pointer-events-none opacity-50' : '' %>">
            Previous
          </a>

          <span class="px-3 py-1.5 font-semibold text-slate-700">
            Page <%= reportPagination.page %> of <%= reportPagination.totalPages %>
          </span>

          <a href="<%= baseReportUrl %>&page=<%= nextPage %>" class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 font-medium text-slate-600 transition-colors <%= reportPagination.page >= reportPagination.totalPages ? 'pointer-events-none opacity-50' : '' %>">
            Next
          </a>
        </div>
      </div>
      <% } %>
    </div>


    <div class="text-center text-xs text-slate-400 pb-8 space-y-2">
      <div>&copy; 2026 Ahnaf, Rafale, and Baruna &bull; MokletCare</div>
      <div class="flex items-center justify-center gap-3 text-slate-400">
        <a href="/privacy-policy" class="hover:text-slate-600 hover:underline transition-colors">Privacy Policy</a>
        <span class="text-slate-300">|</span>
        <a href="/tos" class="hover:text-slate-600 hover:underline transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>

  <!-- Interactive Report Details & Action Modal -->
  <div id="report-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-3xl overflow-hidden flex flex-col max-h-[92vh] transition-all">
      
      <!-- Modal Header -->
      <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100 bg-slate-50/50">
        <div class="flex items-center gap-3">
          <h3 class="text-lg font-bold text-slate-900" id="modal-title">Report Details</h3>
          <span id="modal-status-badge" class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold whitespace-nowrap"></span>
        </div>
        <button onclick="closeReportModal()" class="text-slate-400 hover:text-slate-600 p-1 rounded-lg hover:bg-slate-200/50 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>

      <!-- Modal Body -->
      <div class="p-6 overflow-y-auto space-y-6 flex-1">
        
        <!-- Photo & Location Overview -->
        <div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-start">
            <!-- Damage Photo -->
            <div class="space-y-1.5">
              <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider flex items-center justify-between">
                <span>Damage Photo (Initial)</span>
                <span class="text-[10px] text-slate-400 font-normal">Reported by user</span>
              </div>
              <div class="relative group">
                <a id="modal-photo-link" href="#" target="_blank" rel="noopener noreferrer" class="block">
                  <img id="modal-photo" src="" alt="Damage Photo" class="w-full h-48 object-cover rounded-xl border border-slate-200 shadow-sm hover:opacity-95 transition-opacity">
                  <div class="absolute bottom-2 right-2 bg-slate-900/80 text-white text-[10px] px-2 py-1 rounded font-medium backdrop-blur-sm">Click to Expand</div>
                </a>
              </div>
            </div>

            <!-- Finished / Proof of Repair Photo (If Available) -->
            <div id="modal-finished-photo-container" class="space-y-1.5 hidden">
              <div class="text-xs font-semibold text-emerald-600 uppercase tracking-wider flex items-center justify-between">
                <span class="flex items-center gap-1">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  Finished Photo (Proof of Repair)
                </span>
                <span class="text-[10px] text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-200">Completed</span>
              </div>
              <div class="relative group">
                <a id="modal-finished-photo-link" href="#" target="_blank" rel="noopener noreferrer" class="block">
                  <img id="modal-finished-photo" src="" alt="Finished Photo" class="w-full h-48 object-cover rounded-xl border-2 border-emerald-400 shadow-sm hover:opacity-95 transition-opacity">
                  <div class="absolute bottom-2 right-2 bg-emerald-900/80 text-white text-[10px] px-2 py-1 rounded font-medium backdrop-blur-sm">Click to Expand</div>
                </a>
              </div>
            </div>

            <!-- Location & Facility details (if no finished photo is shown, takes remaining col) -->
            <div id="modal-details-container" class="space-y-3 bg-slate-50/70 p-4 rounded-xl border border-slate-100">
              <div>
                <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Location / Room</div>
                <div class="text-base font-bold text-slate-900 mt-0.5" id="modal-location"></div>
              </div>

              <div>
                <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Facility & Item</div>
                <div class="text-sm font-semibold text-slate-800 mt-0.5" id="modal-item"></div>
                <div class="text-xs text-slate-500" id="modal-facility"></div>
              </div>

              <div class="flex items-center justify-between pt-1">
                <div>
                  <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Urgency</div>
                  <span id="modal-urgency-badge" class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold whitespace-nowrap"></span>
                </div>
                <div class="text-right">
                  <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Submitted</div>
                  <div class="text-xs font-medium text-slate-600 mt-0.5" id="modal-date"></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Reporter Information -->
        <div class="bg-slate-50 p-4 rounded-xl border border-slate-100 flex items-center justify-between">
          <div>
            <div class="text-xs text-slate-400 font-medium">Submitted by Reporter</div>
            <div class="text-sm font-bold text-slate-800" id="modal-reporter-name"></div>
          </div>
          <div class="text-xs font-medium text-slate-600 bg-white px-3 py-1.5 rounded-lg border border-slate-200" id="modal-reporter-email"></div>
        </div>

        <!-- Damage Description -->
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1.5">Damage Description</div>
          <div class="text-sm text-slate-700 bg-slate-50/80 p-4 rounded-xl border border-slate-200 whitespace-pre-wrap leading-relaxed max-h-32 overflow-y-auto" id="modal-description"></div>
        </div>

        <!-- Existing Staff Reply (If any) -->
        <div id="modal-existing-reply-container" class="hidden bg-emerald-50/70 border border-emerald-200 rounded-xl p-4">
          <div class="flex items-center gap-2 mb-1.5">
            <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span class="text-xs font-bold text-emerald-900 uppercase tracking-wider">Current Staff Reply to Reporter</span>
          </div>
          <p class="text-sm text-emerald-800 whitespace-pre-wrap leading-relaxed" id="modal-existing-reply-text"></p>
        </div>

        <!-- Approval Flow Status Banner -->
        <div id="modal-approval-banner" class="hidden">
          <div id="modal-approval-banner-content" class="text-xs px-4 py-3 rounded-xl flex items-center gap-2.5 font-medium">
            <span id="modal-approval-banner-icon"></span>
            <span id="modal-approval-banner-text" class="leading-relaxed"></span>
          </div>
        </div>

        <!-- Admin Approval Required Gate (For Low/Medium urgency when not yet approved) -->
        <div id="modal-approval-gate" class="hidden bg-amber-50/90 border border-amber-200 rounded-2xl p-5 space-y-3 shadow-xs">
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-amber-100 text-amber-700 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
            </div>
            <div class="flex-1">
              <h4 class="text-sm font-bold text-amber-900">Admin Approval Required to Proceed</h4>
              <p class="text-xs text-amber-700 mt-1 leading-relaxed">
                Staff must receive approval from an Administrator on the Approval Page before changing status or proceeding with work on Low/Medium urgency reports.
              </p>
            </div>
          </div>
          <div class="pt-2 flex flex-col sm:flex-row items-center justify-between gap-3 border-t border-amber-200/70">
            <div id="modal-approval-gate-note" class="text-xs font-semibold text-amber-800"></div>
            <button type="button" id="modal-approval-gate-btn" onclick="openPhotoRequestModal()" class="w-full sm:w-auto text-xs bg-amber-600 hover:bg-amber-700 text-white font-bold px-4 py-2.5 rounded-lg transition-colors shadow-sm flex items-center justify-center gap-1.5 cursor-pointer">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>
              <span id="modal-approval-gate-btn-text">Request Admin Approval</span>
            </button>
          </div>
        </div>

        <!-- Staff Resolution & Reply Form Section -->
        <% if (user.role === 'staff') { %>
        <div id="modal-form-container" class="bg-slate-50/90 p-5 rounded-2xl border border-slate-200 space-y-4 transition-opacity">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <div class="w-6 h-6 rounded-md bg-red-100 text-red-600 flex items-center justify-center font-bold text-xs">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"></path></svg>
              </div>
              <h4 class="text-sm font-bold text-slate-900">Reply with Finished Photo & Update Status</h4>
            </div>
            <span class="text-[11px] text-slate-400 font-medium">Updates are sent to reporter</span>
          </div>

          <form id="modal-status-form" method="POST" class="space-y-4">
            <input type="hidden" id="modal-finished-photo-input" name="finished_photo_path" value="">

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <!-- Status Selector -->
              <div>
                <label for="modal-status-select" class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1.5">Report Status</label>
                <select id="modal-status-select" name="status" class="w-full text-xs bg-white border border-slate-200 rounded-lg px-3 py-2.5 text-slate-800 font-semibold focus:outline-none focus:ring-2 focus:ring-red-500 shadow-sm cursor-pointer">
                  <option value="pending">Pending</option>
                  <option value="in_progress">In Progress</option>
                  <option value="resolved">Resolved (Completed)</option>
                  <option value="rejected">Rejected</option>
                </select>
              </div>

              <!-- Finished Photo Upload Action -->
              <div>
                <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1.5">Attach Finished Photo</label>
                <div class="flex items-center gap-2">
                  <input type="file" id="modal-finished-file-upload" accept="image/*" class="sr-only">
                  <button type="button" onclick="document.getElementById('modal-finished-file-upload').click()" class="text-xs bg-white hover:bg-slate-100 text-slate-700 font-medium px-3.5 py-2 rounded-lg border border-slate-200 flex items-center gap-1.5 transition-colors shadow-sm cursor-pointer">
                    <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
                    <span id="modal-finished-upload-text">Upload Finished Photo</span>
                  </button>
                  <span id="modal-finished-upload-status" class="text-xs text-slate-500"></span>
                </div>
              </div>
            </div>

            <!-- Uploaded Finished Photo Preview in Form -->
            <div id="modal-upload-finished-preview" class="hidden flex items-center gap-3 p-3 bg-white rounded-xl border border-slate-200 shadow-sm">
              <img id="modal-upload-finished-img" src="" alt="Finished Preview" class="w-14 h-14 rounded-lg object-cover border border-emerald-300">
              <div class="flex-1 min-w-0">
                <div class="text-xs font-bold text-emerald-700 flex items-center gap-1">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  Finished Photo Attached
                </div>
                <p class="text-[11px] text-slate-500 truncate">Reporter will see this proof of repair photo in their history view.</p>
              </div>
              <button type="button" onclick="removeFinishedPhoto(event)" class="text-xs text-red-600 hover:text-red-700 font-medium px-2 py-1 hover:bg-red-50 rounded-lg transition-colors cursor-pointer">
                Remove
              </button>
            </div>

            <!-- Staff Reply Message Textarea -->
            <div>
              <label for="modal-admin-reply-input" class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1.5">Reply Message / Resolution Notes to Reporter</label>
              <textarea id="modal-admin-reply-input" name="admin_reply" rows="2" placeholder="e.g. Fasilitas telah berhasil diperbaiki oleh tim sarpras dan sudah berfungsi normal kembali." class="w-full bg-white border border-slate-200 rounded-lg p-3 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-red-500 transition resize-none"></textarea>
            </div>

            <div class="flex items-center justify-end gap-3 pt-1">
              <button type="button" onclick="openPhotoRequestModal()" class="text-xs bg-blue-50 text-blue-700 hover:bg-blue-100 border border-blue-200 font-bold px-4 py-2 rounded-lg transition-colors shadow-sm">
                Request Photo Permission
              </button>
              <button type="submit" id="modal-submit-btn" class="text-xs bg-red-600 hover:bg-red-700 text-white font-bold px-5 py-2.5 rounded-lg transition-colors shadow-sm flex items-center gap-1.5 cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                <span>Save Status & Reply</span>
              </button>
            </div>
          </form>
        </div>
        <% } %>

      </div>

      <!-- Modal Footer Close Action -->
      <div class="px-6 py-3.5 bg-slate-50 border-t border-slate-100 flex items-center justify-end">
        <button onclick="closeReportModal()" class="text-xs bg-white text-slate-600 hover:bg-slate-100 border border-slate-200 font-medium px-5 py-2 rounded-lg transition-colors text-center cursor-pointer">
          Close
        </button>
      </div>

    </div>
  </div>

  <!-- Photo Request Modal (for Staff) -->
  <div id="photo-request-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-md overflow-hidden">
      <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100 bg-slate-50/50">
        <h3 class="text-lg font-bold text-slate-900">Send Photo Request</h3>
        <button onclick="closePhotoRequestModal()" class="text-slate-400 hover:text-slate-600 p-1 rounded-lg hover:bg-slate-200/50 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>

      <div class="p-6 space-y-4">
        <div>
          <label class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-2 block">Send to</label>
          <select id="photo-recipient-type" class="w-full bg-white border border-slate-200 rounded-lg px-3 py-2 text-sm text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-blue-500">
            <option value="admin">Admin</option>
            <option value="reporter">Reporter</option>
          </select>
        </div>

        <div>
          <label class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-2 block">Photo Description</label>
          <textarea id="photo-description" placeholder="Describe the photo or additional details..." class="w-full bg-white border border-slate-200 rounded-lg px-3 py-2 text-sm text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-blue-500" rows="3"></textarea>
        </div>

        <div>
          <label class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-2 block">Message (Optional)</label>
          <textarea id="photo-message" placeholder="Add a message..." class="w-full bg-white border border-slate-200 rounded-lg px-3 py-2 text-sm text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-blue-500" rows="2"></textarea>
        </div>

        <div class="bg-blue-50 border border-blue-200 rounded-lg p-3">
          <p class="text-xs text-blue-700"><strong>Note:</strong> Photo URL will be taken from the report details shown above.</p>
        </div>

        <div class="flex gap-3 pt-4">
          <button onclick="sendPhotoRequest()" class="flex-1 text-xs bg-blue-600 hover:bg-blue-700 text-white font-bold px-4 py-2 rounded-lg transition-colors">
            Send Request
          </button>
          <button onclick="closePhotoRequestModal()" class="flex-1 text-xs bg-white text-slate-600 hover:bg-slate-100 border border-slate-200 font-medium px-4 py-2 rounded-lg transition-colors">
            Cancel
          </button>
        </div>
      </div>
    </div>
  </div>

  <script
    async
    crossorigin="anonymous"
    data-clerk-publishable-key="<%= locals.clerkPublishableKey || '' %>"
    src="https://cdn.jsdelivr.net/npm/@clerk/clerk-js@latest/dist/clerk.browser.js"
    type="text/javascript"
  ></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0/dist/chartjs-plugin-datalabels.min.js"></script>
  <script>
    let currentReportData = null;

    function openPhotoRequestModal() {
      currentReportData = document.getElementById('report-modal').dataset;
      document.getElementById('photo-request-modal').classList.remove('hidden');
    }

    function closePhotoRequestModal() {
      document.getElementById('photo-request-modal').classList.add('hidden');
      document.getElementById('photo-description').value = '';
      document.getElementById('photo-message').value = '';
      currentReportData = null;
    }

    async function sendPhotoRequest() {
      if (!currentReportData) {
        alert('No report data found');
        return;
      }

      const recipientType = document.getElementById('photo-recipient-type').value;
      const photoDescription = document.getElementById('photo-description').value.trim();
      const message = document.getElementById('photo-message').value.trim();

      if (!photoDescription) {
        alert('Please enter a photo description');
        return;
      }

      try {
        // Get reporter email from the current report modal
        const reporterEmail = document.getElementById('modal-reporter-email').textContent.trim();
        let recipientEmail = reporterEmail;

        if (recipientType === 'admin') {
          // For admin, use a generic admin email or prompt
          recipientEmail = 'admin@mokletcare.local';
        }

        const response = await fetch('/api/photo-request', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            reportId: parseInt(currentReportData.id),
            photoUrl: currentReportData.photoPath,
            photoDescription,
            recipientType,
            recipientEmail,
            message
          })
        });

        const result = await response.json();

        if (response.ok) {
          alert('Photo request sent successfully!');
          closePhotoRequestModal();
        } else {
          alert('Error: ' + (result.error || 'Failed to send request'));
        }
      } catch (err) {
        console.error('Error sending photo request:', err);
        alert('Error sending photo request. Please try again.');
      }
    }

    let isUploadingFinishedPhoto = false;

    function openReportModal(row) {
      const data = row.dataset;
      document.getElementById('report-modal').dataset.id = data.id;
      document.getElementById('report-modal').dataset.photoPath = data.photoPath;
      document.getElementById('report-modal').dataset.finishedPhotoPath = data.finishedPhotoPath || '';
      document.getElementById('report-modal').dataset.adminReply = data.adminReply || '';
      
      document.getElementById('modal-title').textContent = `Report Details #${data.id}`;
      document.getElementById('modal-location').textContent = data.roomLocation;
      document.getElementById('modal-item').textContent = data.itemLabel;
      document.getElementById('modal-facility').textContent = `${data.facilityLabel} • ${data.damageLabel}`;
      document.getElementById('modal-reporter-name').textContent = data.reporterName;
      document.getElementById('modal-reporter-email').textContent = data.reporterEmail;
      document.getElementById('modal-description').textContent = data.description;
      
      // Damage Photo
      const photoEl = document.getElementById('modal-photo');
      const photoLinkEl = document.getElementById('modal-photo-link');
      photoEl.src = data.photoPath;
      photoLinkEl.href = data.photoPath;

      // Finished Photo (Proof of repair) in View Area
      const finishedPhotoContainer = document.getElementById('modal-finished-photo-container');
      const finishedPhotoEl = document.getElementById('modal-finished-photo');
      const finishedPhotoLinkEl = document.getElementById('modal-finished-photo-link');
      if (data.finishedPhotoPath) {
        finishedPhotoEl.src = data.finishedPhotoPath;
        finishedPhotoLinkEl.href = data.finishedPhotoPath;
        finishedPhotoContainer.classList.remove('hidden');
      } else {
        finishedPhotoContainer.classList.add('hidden');
      }

      // Existing Admin Reply Box
      const existingReplyContainer = document.getElementById('modal-existing-reply-container');
      const existingReplyText = document.getElementById('modal-existing-reply-text');
      if (data.adminReply) {
        existingReplyText.textContent = data.adminReply;
        existingReplyContainer.classList.remove('hidden');
      } else {
        existingReplyContainer.classList.add('hidden');
      }

      if (data.createdAt) {
        document.getElementById('modal-date').textContent = new Date(data.createdAt).toLocaleDateString('en-US', {
          year: 'numeric', month: 'short', day: 'numeric'
        });
      }

      // Status Badge
      const statusBadge = document.getElementById('modal-status-badge');
      if (data.status === 'pending') {
        statusBadge.className = 'inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-600 border border-amber-200 whitespace-nowrap';
        statusBadge.textContent = 'Pending';
      } else if (data.status === 'in_progress') {
        statusBadge.className = 'inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 text-blue-600 border border-blue-200 whitespace-nowrap';
        statusBadge.textContent = 'In Progress';
      } else if (data.status === 'resolved') {
        statusBadge.className = 'inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-600 border border-emerald-200 whitespace-nowrap';
        statusBadge.textContent = 'Resolved';
      } else {
        statusBadge.className = 'inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-600 border border-slate-200 whitespace-nowrap';
        statusBadge.textContent = 'Rejected';
      }

      // Urgency Badge
      const urgencyBadge = document.getElementById('modal-urgency-badge');
      urgencyBadge.textContent = data.urgencyLabel;
      const isHighUrgency = ['high', 'critical', 'severe', 'Darurat / Penting'].includes(data.urgencyLevel) || 
        (data.urgencyLabel && (data.urgencyLabel.toLowerCase().includes('high') || data.urgencyLabel.toLowerCase().includes('critical') || data.urgencyLabel.toLowerCase().includes('tinggi') || data.urgencyLabel.toLowerCase().includes('kritis')));

      if (isHighUrgency) {
        urgencyBadge.className = 'inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-700 whitespace-nowrap';
      } else if (data.urgencyLevel === 'medium' || data.urgencyLevel === 'Sedang') {
        urgencyBadge.className = 'inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-700 whitespace-nowrap';
      } else {
        urgencyBadge.className = 'inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-700 whitespace-nowrap';
      }

      // Approval Flow Checks: High & Above can proceed directly; Low/Medium require admin approval
      const isApproved = data.isApproved === 'true';
      const hasPendingApproval = data.hasPendingApproval === 'true';
      const canProceed = isHighUrgency || isApproved || data.status === 'in_progress' || data.status === 'resolved';

      const bannerContainer = document.getElementById('modal-approval-banner');
      const bannerContent = document.getElementById('modal-approval-banner-content');
      const bannerIcon = document.getElementById('modal-approval-banner-icon');
      const bannerText = document.getElementById('modal-approval-banner-text');
      const gateContainer = document.getElementById('modal-approval-gate');
      const gateNote = document.getElementById('modal-approval-gate-note');
      const gateBtnText = document.getElementById('modal-approval-gate-btn-text');
      const formContainer = document.getElementById('modal-form-container');

      if (isHighUrgentOrAbove(data.urgencyLevel, data.urgencyLabel)) {
        if (bannerContainer) {
          bannerContainer.classList.remove('hidden');
          bannerContent.className = 'text-xs px-4 py-3 rounded-xl flex items-center gap-2.5 font-medium bg-emerald-50 border border-emerald-200 text-emerald-800';
          bannerIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>';
          bannerText.innerHTML = '<strong class="font-bold text-emerald-950">⚡ Direct Proceed (High Urgency):</strong> This report is marked high/critical priority and does not require prior Admin approval.';
        }
        if (gateContainer) gateContainer.classList.add('hidden');
        if (formContainer) {
          formContainer.classList.remove('opacity-60', 'pointer-events-none');
        }
      } else if (isApproved) {
        if (bannerContainer) {
          bannerContainer.classList.remove('hidden');
          bannerContent.className = 'text-xs px-4 py-3 rounded-xl flex items-center gap-2.5 font-medium bg-emerald-50 border border-emerald-200 text-emerald-800';
          bannerIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>';
          bannerText.innerHTML = '<strong class="font-bold text-emerald-950">✓ Approved by Admin:</strong> An Administrator has approved this request on the Approval Page. You can proceed with status updates and repair resolution.';
        }
        if (gateContainer) gateContainer.classList.add('hidden');
        if (formContainer) {
          formContainer.classList.remove('opacity-60', 'pointer-events-none');
        }
      } else {
        if (bannerContainer) bannerContainer.classList.add('hidden');
        if (gateContainer) {
          gateContainer.classList.remove('hidden');
          if (hasPendingApproval) {
            gateNote.innerHTML = '<span class="text-amber-800">⏳ Approval request is <strong>Pending Review</strong> on the Admin Approval Page.</span>';
            if (gateBtnText) gateBtnText.textContent = 'Resend Request to Admin';
          } else {
            gateNote.innerHTML = '<span class="text-amber-800">⚠️ Staff must request and receive Admin approval before proceeding.</span>';
            if (gateBtnText) gateBtnText.textContent = 'Request Admin Approval';
          }
        }
        if (formContainer) {
          formContainer.classList.add('opacity-60', 'pointer-events-none');
        }
      }

      // Populate Admin Action Form
      const form = document.getElementById('modal-status-form');
      if (form) {
        form.action = `/dashboard/reports/${data.id}/reply`;
        document.getElementById('modal-status-select').value = data.status;
        document.getElementById('modal-admin-reply-input').value = data.adminReply || '';
        
        const photoInput = document.getElementById('modal-finished-photo-input');
        const previewContainer = document.getElementById('modal-upload-finished-preview');
        const previewImg = document.getElementById('modal-upload-finished-img');
        const uploadText = document.getElementById('modal-finished-upload-text');
        const uploadStatus = document.getElementById('modal-finished-upload-status');

        if (uploadStatus) uploadStatus.textContent = '';

        if (data.finishedPhotoPath) {
          photoInput.value = data.finishedPhotoPath;
          previewImg.src = data.finishedPhotoPath;
          previewContainer.classList.remove('hidden');
          uploadText.textContent = 'Change finished photo';
        } else {
          photoInput.value = '';
          previewImg.src = '';
          previewContainer.classList.add('hidden');
          uploadText.textContent = 'Upload finished photo';
        }
      }

      document.getElementById('report-modal').classList.remove('hidden');
    }

    function isHighUrgentOrAbove(level, label) {
      if (!level && !label) return false;
      const str = ((level || '') + ' ' + (label || '')).toLowerCase();
      return str.includes('high') || str.includes('critical') || str.includes('severe') || str.includes('tinggi') || str.includes('kritis') || str.includes('darurat') || str.includes('penting');
    }

    function removeFinishedPhoto(e) {
      if (e) e.stopPropagation();
      const photoInput = document.getElementById('modal-finished-photo-input');
      const fileInput = document.getElementById('modal-finished-file-upload');
      const previewContainer = document.getElementById('modal-upload-finished-preview');
      const previewImg = document.getElementById('modal-upload-finished-img');
      const uploadText = document.getElementById('modal-finished-upload-text');
      const uploadStatus = document.getElementById('modal-finished-upload-status');

      if (photoInput) photoInput.value = '';
      if (fileInput) fileInput.value = '';
      if (previewImg) previewImg.src = '';
      if (previewContainer) previewContainer.classList.add('hidden');
      if (uploadText) uploadText.textContent = 'Upload finished photo';
      if (uploadStatus) uploadStatus.textContent = '';
    }

    function setupFinishedPhotoUpload() {
      const fileInput = document.getElementById('modal-finished-file-upload');
      if (!fileInput) return;

      fileInput.addEventListener('change', async function() {
        if (this.files && this.files[0]) {
          const file = this.files[0];
          const uploadStatus = document.getElementById('modal-finished-upload-status');
          const previewContainer = document.getElementById('modal-upload-finished-preview');
          const previewImg = document.getElementById('modal-upload-finished-img');
          const photoInput = document.getElementById('modal-finished-photo-input');
          const uploadText = document.getElementById('modal-finished-upload-text');

          if (file.size > 5 * 1024 * 1024) {
            alert('File size exceeds 5MB limit. Please choose a smaller image.');
            this.value = '';
            return;
          }

          isUploadingFinishedPhoto = true;
          uploadStatus.innerHTML = `<span class="text-blue-600 inline-flex items-center gap-1 font-medium"><svg class="animate-spin h-3.5 w-3.5 inline" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Uploading...</span>`;

          const formData = new FormData();
          formData.append('file', file);

          try {
            const res = await fetch('/upload-image', {
              method: 'POST',
              body: formData,
              headers: { 'Accept': 'application/json' }
            });

            const data = await res.json();
            if (!res.ok) {
              throw new Error(data.error || 'Upload failed');
            }

            photoInput.value = data.url;
            previewImg.src = data.url;
            previewContainer.classList.remove('hidden');
            uploadText.textContent = 'Change finished photo';
            uploadStatus.innerHTML = `<span class="text-emerald-600 font-semibold">✓ Uploaded</span>`;

            // Auto-select resolved status if pending/in_progress
            const statusSelect = document.getElementById('modal-status-select');
            if (statusSelect && statusSelect.value !== 'resolved') {
              statusSelect.value = 'resolved';
            }
          } catch (err) {
            console.error('Error uploading finished photo:', err);
            uploadStatus.innerHTML = `<span class="text-red-600 font-medium">${err.message || 'Upload failed'}</span>`;
          } finally {
            isUploadingFinishedPhoto = false;
          }
        }
      });
    }

    // Attach form submit protection
    const statusForm = document.getElementById('modal-status-form');
    if (statusForm) {
      statusForm.addEventListener('submit', function(e) {
        if (isUploadingFinishedPhoto) {
          e.preventDefault();
          alert('Please wait for the finished photo upload to complete.');
          return;
        }
        const btn = document.getElementById('modal-submit-btn');
        if (btn) {
          btn.innerHTML = `<svg class="animate-spin h-4 w-4 text-white inline" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> <span class="ml-1">Saving...</span>`;
          btn.disabled = true;
        }
      });
    }

    function closeReportModal() {
      document.getElementById('report-modal').classList.add('hidden');
    }

    // Backdrop click close
    document.getElementById('report-modal').addEventListener('click', (e) => {
      if (e.target === document.getElementById('report-modal')) {
        closeReportModal();
      }
    });

    // Escape key close
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeReportModal();
      }
    });

    window.addEventListener('load', async () => {
      if (window.Clerk) {
        try {
          await window.Clerk.load();
        } catch (e) {}
      }

      setupFinishedPhotoUpload();

      // Register Chart.js plugins
      Chart.register(ChartDataLabels);

      // Initialize Status Chart
      const ctx = document.getElementById('statusChart');
      if (ctx) {
        const statsEl = document.querySelector('[data-stats-pending]');
        const chartData = [
          parseInt(statsEl.dataset.statsPending),
          parseInt(statsEl.dataset.statsInProgress),
          parseInt(statsEl.dataset.statsResolved),
          parseInt(statsEl.dataset.statsRejected)
        ];
        new Chart(ctx, {
          type: 'pie',
          data: {
            labels: ['Pending', 'In Progress', 'Resolved', 'Rejected'],
            datasets: [
              {
                label: 'Reports',
                data: chartData,
                backgroundColor: [
                  '#2563EB',
                  '#FF8C42',
                  '#22C55E',
                  '#DC2626'
                ],
                borderColor: [
                  '#1E40AF',
                  '#EA580C',
                  '#16A34A',
                  '#B91C1C'
                ],
                borderWidth: 2
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: true,
            plugins: {
              legend: {
                display: true,
                position: 'right',
                labels: {
                  font: {
                    size: 12,
                    weight: '500'
                  },
                  padding: 15,
                  usePointStyle: true,
                  pointStyle: 'circle'
                }
              },
              tooltip: {
                callbacks: {
                  label: function(context) {
                    const label = context.label || '';
                    const value = context.parsed;
                    const total = context.dataset.data.reduce((a, b) => a + b, 0);
                    const percentage = ((value / total) * 100).toFixed(1);
                    return label + ': ' + value + ' (' + percentage + '%)';
                  }
                }
              },
              datalabels: {
                formatter: (value, ctx) => {
                  const sum = ctx.dataset.data.reduce((a, b) => a + b, 0);
                  const percentage = (value * 100 / sum).toFixed(1) + '%';
                  return percentage;
                },
                color: '#fff',
                font: {
                  weight: 'bold',
                  size: 14
                }
              }
            }
          }
        });
      }
    });
  </script>
</body>
</html>
