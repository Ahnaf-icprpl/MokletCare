# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL / Neon / Supabase)
DATABASE_URL=postgres://username:password@localhost:5432/mokletcare

# Clerk Authentication (https://clerk.com)
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
# Optional alias for frontend
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Admin Email Configuration (Comma-separated list of bootstrap admin emails)
ADMIN_EMAILS=admin@mokletcare.sch.id,principal@mokletcare.sch.id
# Fallback single admin email
ADMIN_EMAIL=admin@mokletcare.sch.id

# Cloudinary Media Storage (https://cloudinary.com)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
